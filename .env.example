# Configuración de Supabase para Maceiras Catering & Chef Privado
# Obtén estos valores en tu dashboard de Supabase (Project Settings > API)

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# PIN de Seguridad para el Panel de Administración (Por defecto: maceiras2026)
VITE_ADMIN_PIN=maceiras2026
