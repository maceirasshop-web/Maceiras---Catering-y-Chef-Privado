  file_change {
    absolute_path_uri: "file:///src/components/Hero3D.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useRef, useState } from \'react\';\nimport * as THREE from \'three\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { Sparkles, Utensils, Award, ChefHat, Eye } from \'lucide-react\';\n\ninterface Dish {\n  id: string;\n  category: string;\n  name: string;\n  description: string;\n  pairing: string;\n  imageUrl: string;\n  badge: string;\n}\n\nconst DISHES: Dish[] = [\n  {\n    id: \'wellington\',\n    category: \'Plato Principal Signature\',\n    name: \'Filete Mignon & Risotto de Trufa\',\n    description: \'Corte de solomillo sobre cremoso risotto de setas silvestres, reducci\303\263n de carmen\303\250re y brotes frescos.\',\n    pairing: \'Maridaje: Carmen\303\250re Gran Reserva\',\n    imageUrl: \'https://images.unsplash.com/photo-1544025162-d76694265947?q=80&w=1000&auto=format&fit=crop\',\n    badge: \'Alta Gastronom\303\255a\',\n  },\n  {\n    id: \'seafood\',\n    category: \'Entrada de Autor\',\n    name: \'Langostinos Patag\303\263nicos & Azafr\303\241n\',\n    description: \'Langostinos a la parrilla sobre emulsi\303\263n c\303\255trica de azafr\303\241n, quenelle de palta y sal marina ahumada.\',\n    pairing: \'Maridaje: Sauvignon Blanc Leyda\',\n    imageUrl: \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?q=80&w=1000&auto=format&fit=crop\',\n    badge: \'Selecci\303\263n del Chef\',\n  },\n  {\n    id: \'dessert\',\n    category: \'Postre de Autor\',\n    name: \'Volc\303\241n de Cacao 70% & Hoja de Oro\',\n    description: \'Coulant caliente de chocolate belga con helado artesanal de vainilla Bourbon y frutos rojos.\',\n    pairing: \'Maridaje: Oporto Late Bottled Vintage\',\n    imageUrl: \'https://images.unsplash.com/photo-1551024709-8f23befc6f87?q=80&w=1000&auto=format&fit=crop\',\n    badge: \'Reposter\303\255a Fina\',\n  }\n];\n\nexport const Hero3D: React.FC = () => {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const canvasContainerRef = useRef<HTMLDivElement>(null);\n  const [selectedDish, setSelectedDish] = useState<Dish>(DISHES[0]);\n  const [tilt, setTilt] = useState({ x: 0, y: 0 });\n\n  // WebGL 3D Ambient Dust Particles & Golden Bokeh Background Scene\n  useEffect(() => {\n    if (!canvasContainerRef.current) return;\n\n    const container = canvasContainerRef.current;\n    const width = container.clientWidth;\n    const height = container.clientHeight;\n\n    const scene = new THREE.Scene();\n    const camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);\n    camera.position.set(0, 0, 8);\n\n    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n    renderer.setSize(width, height);\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n\n    container.appendChild(renderer.domElement);\n\n    // Create 3D Gold & Warm Bokeh Particle Swarm\n    const particleCount = 120;\n    const geometry = new THREE.BufferGeometry();\n    const positions = new Float32Array(particleCount * 3);\n    const scales = new Float32Array(particleCount);\n\n    for (let i = 0; i < particleCount; i++) {\n      positions[i * 3] = (Math.random() - 0.5) * 12;\n      positions[i * 3 + 1] = (Math.random() - 0.5) * 10;\n      positions[i * 3 + 2] = (Math.random() - 0.5) * 6;\n      scales[i] = Math.random() * 0.08 + 0.03;\n    }\n\n    geometry.setAttribute(\'position\', new THREE.BufferAttribute(positions, 3));\n\n    // Particle Material\n    const material = new THREE.PointsMaterial({\n      color: 0xD27D56,\n      size: 0.12,\n      transparent: true,\n      opacity: 0.55,\n      blending: THREE.AdditiveBlending,\n    });\n\n    const particles = new THREE.Points(geometry, material);\n    scene.add(particles);\n\n    // Decorative Rotating Gold Ring in 3D\n    const ringGeo = new THREE.TorusGeometry(3.2, 0.012, 16, 100);\n    const ringMat = new THREE.MeshBasicMaterial({ color: 0xD27D56, transparent: true, opacity: 0.25 });\n    const ring = new THREE.Mesh(ringGeo, ringMat);\n    ring.rotation.x = Math.PI / 3;\n    scene.add(ring);\n\n    const secondRingGeo = new THREE.TorusGeometry(2.5, 0.008, 16, 80);\n    const secondRingMat = new THREE.MeshBasicMaterial({ color: 0x5A5A40, transparent: true, opacity: 0.2 });\n    const secondRing = new THREE.Mesh(secondRingGeo, secondRingMat);\n    secondRing.rotation.y = Math.PI / 4;\n    scene.add(secondRing);\n\n    // Animation Loop\n    let animationFrameId: number;\n    let clock = new THREE.Clock();\n\n    const animate = () => {\n      animationFrameId = requestAnimationFrame(animate);\n      const elapsedTime = clock.getElapsedTime();\n\n      // Slow rotation of particles and rings\n      particles.rotation.y = elapsedTime * 0.04;\n      particles.rotation.x = Math.sin(elapsedTime * 0.02) * 0.05;\n\n      ring.rotation.z = elapsedTime * 0.08;\n      secondRing.rotation.x = elapsedTime * -0.06;\n\n      renderer.render(scene, camera);\n    };\n\n    animate();\n\n    const handleResize = () => {\n      if (!canvasContainerRef.current) return;\n      const w = canvasContainerRef.current.clientWidth;\n      const h = canvasContainerRef.current.clientHeight;\n      camera.aspect = w / h;\n      camera.updateProjectionMatrix();\n      renderer.setSize(w, h);\n    };\n\n    window.addEventListener(\'resize\', handleResize);\n\n    return () => {\n      window.removeEventListener(\'resize\', handleResize);\n      cancelAnimationFrame(animationFrameId);\n      geometry.dispose();\n      material.dispose();\n      ringGeo.dispose();\n      ringMat.dispose();\n      secondRingGeo.dispose();\n      secondRingMat.dispose();\n      renderer.dispose();\n      if (container && renderer.domElement && container.contains(renderer.domElement)) {\n        container.removeChild(renderer.domElement);\n      }\n    };\n  }, []);\n\n  // Parallax Tilt Effect on Mouse Move\n  const handleMouseMove = (e: React.MouseEvent<HTMLDivElement>) => {\n    if (!containerRef.current) return;\n    const rect = containerRef.current.getBoundingClientRect();\n    const x = (e.clientX - rect.left) / rect.width - 0.5;\n    const y = (e.clientY - rect.top) / rect.height - 0.5;\n    setTilt({ x: x * 12, y: -y * 12 });\n  };\n\n  const handleMouseLeave = () => {\n    setTilt({ x: 0, y: 0 });\n  };\n\n  return (\n    <div \n      ref={containerRef}\n      onMouseMove={handleMouseMove}\n      onMouseLeave={handleMouseLeave}\n      className=\"relative w-full max-w-lg mx-auto py-4 flex flex-col items-center justify-center select-none\"\n    >\n      {/* Background WebGL 3D Canvas Layer */}\n      <div \n        ref={canvasContainerRef} \n        className=\"absolute inset-0 w-full h-full pointer-events-none -z-10 overflow-hidden\" \n      />\n\n      {/* Main 3D Tilt Card Container */}\n      <motion.div\n        style={{\n          transformStyle: \'preserve-3d\',\n          rotateY: tilt.x,\n          rotateX: tilt.y,\n        }}\n        transition={{ type: \'spring\', stiffness: 200, damping: 20 }}\n        className=\"w-full bg-white/90 backdrop-blur-md border border-[#2A2A2A]/10 rounded-sm p-4 sm:p-6 shadow-2xl relative overflow-hidden\"\n      >\n        {/* Decorative corner accents */}\n        <div className=\"absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-[#D27D56]/60 pointer-events-none\" />\n        <div className=\"absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-[#D27D56]/60 pointer-events-none\" />\n        <div className=\"absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 border-[#D27D56]/60 pointer-events-none\" />\n        <div className=\"absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-[#D27D56]/60 pointer-events-none\" />\n\n        {/* Header Badge */}\n        <div className=\"flex items-center justify-between mb-3 text-xs font-sans\">\n          <span className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#F5F2ED] border border-[#2A2A2A]/10 text-[#5A5A40] text-[11px] font-medium tracking-wider uppercase\">\n            <ChefHat className=\"w-3.5 h-3.5 text-[#D27D56]\" />\n            {selectedDish.badge}\n          </span>\n          <span className=\"text-[11px] uppercase tracking-widest text-[#2A2A2A]/60 font-serif italic\">\n            Maceiras Privado\n          </span>\n        </div>\n\n        {/* Dish Image Stage with Smooth Fade Transition */}\n        <div className=\"relative aspect-[4/3] w-full rounded-xs overflow-hidden bg-[#2A2A2A] mb-4 group shadow-inner\">\n          <AnimatePresence mode=\"wait\">\n            <motion.img\n              key={selectedDish.id}\n              src={selectedDish.imageUrl}\n              alt={selectedDish.name}\n              referrerPolicy=\"no-referrer\"\n              initial={{ opacity: 0, scale: 1.06 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 0.96 }}\n              transition={{ duration: 0.6, ease: [0.16, 1, 0.3, 1] }}\n              className=\"w-full h-full object-cover object-center\"\n            />\n          </AnimatePresence>\n\n          {/* Vignette & Soft Gradient Overlay */}\n          <div className=\"absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent pointer-events-none\" />\n\n          {/* Category Tag directly on photo */}\n          <div className=\"absolute top-3 left-3 bg-black/60 backdrop-blur-md px-3 py-1 rounded-xs text-[10px] uppercase tracking-widest text-[#F5F2ED] font-sans border border-white/10\">\n            {selectedDish.category}\n          </div>\n\n          {/* Sommelier Pairing Tag */}\n          <div className=\"absolute bottom-3 right-3 bg-black/70 backdrop-blur-md px-3 py-1 rounded-xs text-[10px] text-[#EADDCA] font-sans border border-[#D27D56]/40 flex items-center gap-1.5\">\n            <Sparkles className=\"w-3 h-3 text-[#D27D56]\" />\n            <span>{selectedDish.pairing}</span>\n          </div>\n        </div>\n\n        {/* Dish Details */}\n        <div className=\"space-y-2 mb-5\">\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={selectedDish.id}\n              initial={{ opacity: 0, y: 8 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -8 }}\n              transition={{ duration: 0.3 }}\n            >\n              <h3 className=\"font-serif text-xl sm:text-2xl text-[#2A2A2A] font-light leading-snug\">\n                {selectedDish.name}\n              </h3>\n              <p className=\"text-xs text-[#2A2A2A]/70 font-sans font-light leading-relaxed mt-1\">\n                {selectedDish.description}\n              </p>\n            </motion.div>\n          </AnimatePresence>\n        </div>\n\n        {/* Interactive Dish Selector Tabs */}\n        <div className=\"pt-3 border-t border-[#2A2A2A]/10 grid grid-cols-3 gap-2\">\n          {DISHES.map((dish) => {\n            const isSelected = dish.id === selectedDish.id;\n            return (\n              <button\n                key={dish.id}\n                onClick={() => setSelectedDish(dish)}\n                className={`px-2 py-2 rounded-xs text-[10px] font-sans font-medium uppercase tracking-wider transition-all duration-300 text-center cursor-pointer border ${\n                  isSelected\n                    ? \'bg-[#5A5A40] text-[#F5F2ED] border-[#5A5A40] shadow-sm\'\n                    : \'bg-[#F5F2ED]/80 text-[#2A2A2A]/70 border-[#2A2A2A]/10 hover:bg-[#EADDCA]/50 hover:text-[#2A2A2A]\'\n                }`}\n              >\n                {dish.id === \'wellington\' && \'Principal\'}\n                {dish.id === \'seafood\' && \'Entrada\'}\n                {dish.id === \'dessert\' && \'Postre\'}\n              </button>\n            );\n          })}\n        </div>\n      </motion.div>\n    </div>\n  );\n};\n"
    }
