        lines {
          text: "    for (let i = 0; i < 7; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const gGeo = new THREE.SphereGeometry(0.04 + Math.random() * 0.03, 12, 12);"
