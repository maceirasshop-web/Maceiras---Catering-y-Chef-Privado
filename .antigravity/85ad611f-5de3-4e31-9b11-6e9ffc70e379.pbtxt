  file_change {
    absolute_path_uri: "file:///src/components/Hero3D.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useEffect, useRef } from \'react\';\nimport * as THREE from \'three\';\n\nexport const Hero3D: React.FC = () => {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    if (!containerRef.current) return;\n\n    const container = containerRef.current;\n    const width = container.clientWidth;\n    const height = container.clientHeight;\n\n    // 1. Scene setup\n    const scene = new THREE.Scene();\n    // Warm cream subtle fog to integrate cleanly into background\n    scene.fog = new THREE.FogExp2(0xF5F2ED, 0.08);\n\n    // 2. Camera setup\n    const camera = new THREE.PerspectiveCamera(38, width / height, 0.1, 100);\n    camera.position.set(0, 0, 7.5);\n\n    // 3. Renderer setup\n    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n    renderer.setSize(width, height);\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n    renderer.shadowMap.enabled = true;\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\n    renderer.toneMappingExposure = 1.05;\n\n    // Clear background to match warm cream\n    container.appendChild(renderer.domElement);\n\n    // 4. Lighting setup (Soft, realistic, warm lighting)\n    const ambientLight = new THREE.AmbientLight(0xFFFAF0, 1.2);\n    scene.add(ambientLight);\n\n    // Main key light (warm studio light from top right)\n    const dirLight = new THREE.DirectionalLight(0xFFF6E5, 2.2);\n    dirLight.position.set(4, 6, 5);\n    dirLight.castShadow = true;\n    dirLight.shadow.mapSize.width = 1024;\n    dirLight.shadow.mapSize.height = 1024;\n    dirLight.shadow.camera.near = 0.5;\n    dirLight.shadow.camera.far = 15;\n    dirLight.shadow.bias = -0.0005;\n    scene.add(dirLight);\n\n    // Soft rim light (olive green / terracotta soft accent from back left)\n    const rimLight = new THREE.DirectionalLight(0xD17A5D, 0.8);\n    rimLight.position.set(-4, -2, -3);\n    scene.add(rimLight);\n\n    // Subtle fill point light (soft warm glow)\n    const fillLight = new THREE.PointLight(0x3A4335, 1.0, 10);\n    fillLight.position.set(-2, 3, 2);\n    scene.add(fillLight);\n\n    // 5. Create procedural 3D Gourmet Dishes\n    const dishesGroup = new THREE.Group();\n    scene.add(dishesGroup);\n\n    // Shared Materials\n    const ceramicMat = new THREE.MeshStandardMaterial({\n      color: 0xF7F4EE,\n      roughness: 0.15,\n      metalness: 0.05,\n    });\n\n    const goldTrimMat = new THREE.MeshStandardMaterial({\n      color: 0xC5A059,\n      roughness: 0.25,\n      metalness: 0.85,\n    });\n\n    const terracottaFoodMat = new THREE.MeshStandardMaterial({\n      color: 0xC86D51,\n      roughness: 0.4,\n      metalness: 0.1,\n    });\n\n    const oliveGarnishMat = new THREE.MeshStandardMaterial({\n      color: 0x3A4335,\n      roughness: 0.5,\n      metalness: 0.0,\n    });\n\n    const glassMat = new THREE.MeshPhysicalMaterial({\n      color: 0xFFFFFF,\n      transparent: true,\n      opacity: 0.35,\n      roughness: 0.1,\n      transmission: 0.85,\n      thickness: 0.5,\n    });\n\n    // --- DISH 1: Main Gourmet Plate (Center-bottom) ---\n    const plate1Group = new THREE.Group();\n\n    // Plate base (lathe or layered cylinders)\n    const plateRimGeo = new THREE.CylinderGeometry(1.4, 0.8, 0.12, 48);\n    const plateRim = new THREE.Mesh(plateRimGeo, ceramicMat);\n    plateRim.castShadow = true;\n    plateRim.receiveShadow = true;\n    plate1Group.add(plateRim);\n\n    // Gold accent ring on rim\n    const goldRingGeo = new THREE.TorusGeometry(1.35, 0.015, 16, 48);\n    const goldRing = new THREE.Mesh(goldRingGeo, goldTrimMat);\n    goldRing.rotation.x = Math.PI / 2;\n    goldRing.position.y = 0.061;\n    plate1Group.add(goldRing);\n\n    // Center food arrangement (fine dining artistic composition)\n    const mainFoodGeo = new THREE.CylinderGeometry(0.5, 0.55, 0.18, 32);\n    const mainFood = new THREE.Mesh(mainFoodGeo, terracottaFoodMat);\n    mainFood.position.y = 0.12;\n    mainFood.castShadow = true;\n    plate1Group.add(mainFood);\n\n    // Microgreen garnishes (small floating dots/spheres)\n    for (let i = 0; i < 7; i++) {\n      const gGeo = new THREE.SphereGeometry(0.04 + Math.random() * 0.03, 12, 12);\n      const gMesh = new THREE.Mesh(gGeo, oliveGarnishMat);\n      const angle = (i / 7) * Math.PI * 2;\n      const radius = 0.25 + Math.random() * 0.15;\n      gMesh.position.set(Math.cos(angle) * radius, 0.24 + Math.random() * 0.05, Math.sin(angle) * radius);\n      gMesh.castShadow = true;\n      plate1Group.add(gMesh);\n    }\n\n    plate1Group.position.set(-0.2, -0.4, 0.2);\n    plate1Group.rotation.x = 0.5;\n    plate1Group.rotation.z = -0.1;\n    dishesGroup.add(plate1Group);\n\n    // --- DISH 2: Gourmet Cloche / Saucer (Top Right) ---\n    const plate2Group = new THREE.Group();\n\n    const saucerGeo = new THREE.CylinderGeometry(0.9, 0.5, 0.08, 40);\n    const saucer = new THREE.Mesh(saucerGeo, ceramicMat);\n    saucer.castShadow = true;\n    saucer.receiveShadow = true;\n    plate2Group.add(saucer);\n\n    // Glass cloche dome\n    const domeGeo = new THREE.SphereGeometry(0.7, 32, 24, 0, Math.PI * 2, 0, Math.PI * 0.5);\n    const dome = new THREE.Mesh(domeGeo, glassMat);\n    dome.position.y = 0.04;\n    plate2Group.add(dome);\n\n    // Glass handle knob\n    const knobGeo = new THREE.SphereGeometry(0.1, 16, 16);\n    const knob = new THREE.Mesh(knobGeo, goldTrimMat);\n    knob.position.y = 0.74;\n    plate2Group.add(knob);\n\n    plate2Group.position.set(1.5, 0.9, -0.4);\n    plate2Group.rotation.x = 0.6;\n    plate2Group.rotation.y = -0.2;\n    dishesGroup.add(plate2Group);\n\n    // --- DISH 3: Artisanal Ceramic Tasting Vessel (Bottom Left) ---\n    const plate3Group = new THREE.Group();\n\n    const bowlGeo = new THREE.CylinderGeometry(0.65, 0.35, 0.45, 32);\n    const bowl = new THREE.Mesh(bowlGeo, ceramicMat);\n    bowl.castShadow = true;\n    bowl.receiveShadow = true;\n    plate3Group.add(bowl);\n\n    // Inner liquid / glaze\n    const liquidGeo = new THREE.CylinderGeometry(0.6, 0.6, 0.02, 32);\n    const liquidMat = new THREE.MeshStandardMaterial({\n      color: 0x3A4335,\n      roughness: 0.1,\n      metalness: 0.1,\n    });\n    const liquid = new THREE.Mesh(liquidGeo, liquidMat);\n    liquid.position.y = 0.18;\n    plate3Group.add(liquid);\n\n    plate3Group.position.set(-1.6, 0.7, -0.6);\n    plate3Group.rotation.x = 0.45;\n    plate3Group.rotation.y = 0.3;\n    dishesGroup.add(plate3Group);\n\n    // Shadow Catcher plane underneath\n    const shadowPlaneGeo = new THREE.PlaneGeometry(12, 12);\n    const shadowPlaneMat = new THREE.ShadowMaterial({ opacity: 0.06 });\n    const shadowPlane = new THREE.Mesh(shadowPlaneGeo, shadowPlaneMat);\n    shadowPlane.rotation.x = -Math.PI / 2;\n    shadowPlane.position.y = -2.2;\n    shadowPlane.receiveShadow = true;\n    scene.add(shadowPlane);\n\n    // 6. Mouse Parallax Handler\n    let mouseX = 0;\n    let mouseY = 0;\n    let targetX = 0;\n    let targetY = 0;\n\n    const handleMouseMove = (e: MouseEvent) => {\n      const rect = container.getBoundingClientRect();\n      const x = (e.clientX - rect.left) / rect.width - 0.5;\n      const y = (e.clientY - rect.top) / rect.height - 0.5;\n      targetX = x * 0.8;\n      targetY = y * 0.8;\n    };\n\n    window.addEventListener(\'mousemove\', handleMouseMove);\n\n    // 7. Smooth Animation Loop\n    let animationFrameId: number;\n    let clock = new THREE.Clock();\n\n    const animate = () => {\n      animationFrameId = requestAnimationFrame(animate);\n\n      const elapsedTime = clock.getElapsedTime();\n\n      // Smooth mouse interpolation (lerp)\n      mouseX += (targetX - mouseX) * 0.05;\n      mouseY += (targetY - mouseY) * 0.05;\n\n      // Group smooth parallax rotation\n      dishesGroup.rotation.y = mouseX * 0.5 + Math.sin(elapsedTime * 0.25) * 0.05;\n      dishesGroup.rotation.x = -mouseY * 0.3 + Math.cos(elapsedTime * 0.2) * 0.04;\n\n      // Individual subtle dish floating motions\n      plate1Group.position.y = -0.4 + Math.sin(elapsedTime * 1.2) * 0.08;\n      plate1Group.rotation.y = Math.sin(elapsedTime * 0.5) * 0.1;\n\n      plate2Group.position.y = 0.9 + Math.sin(elapsedTime * 0.9 + 1) * 0.1;\n      plate2Group.rotation.z = Math.cos(elapsedTime * 0.6) * 0.06;\n\n      plate3Group.position.y = 0.7 + Math.sin(elapsedTime * 1.1 + 2) * 0.09;\n      plate3Group.rotation.x = 0.45 + Math.sin(elapsedTime * 0.7) * 0.05;\n\n      renderer.render(scene, camera);\n    };\n\n    animate();\n\n    // 8. Responsive Resize Handler\n    const handleResize = () => {\n      if (!containerRef.current) return;\n      const w = containerRef.current.clientWidth;\n      const h = containerRef.current.clientHeight;\n      camera.aspect = w / h;\n      camera.updateProjectionMatrix();\n      renderer.setSize(w, h);\n    };\n\n    window.addEventListener(\'resize\', handleResize);\n\n    // Cleanup on unmount\n    return () => {\n      window.removeEventListener(\'mousemove\', handleMouseMove);\n      window.removeEventListener(\'resize\', handleResize);\n      cancelAnimationFrame(animationFrameId);\n\n      // Dispose geometries and materials\n      [plateRimGeo, goldRingGeo, mainFoodGeo, saucerGeo, domeGeo, knobGeo, bowlGeo, liquidGeo, shadowPlaneGeo].forEach(g => g.dispose());\n      [ceramicMat, goldTrimMat, terracottaFoodMat, oliveGarnishMat, glassMat, liquidMat, shadowPlaneMat].forEach(m => m.dispose());\n      renderer.dispose();\n\n      if (container && renderer.domElement && container.contains(renderer.domElement)) {\n        container.removeChild(renderer.domElement);\n      }\n    };\n  }, []);\n\n  return (\n    <div \n      ref={containerRef} \n      className=\"w-full h-[420px] md:h-[540px] relative flex items-center justify-center overflow-hidden cursor-grab active:cursor-grabbing\"\n      aria-label=\"Escena 3D interactiva de platillos gourmet\"\n    >\n      {/* Subtle background ambient ring */}\n      <div className=\"absolute inset-0 pointer-events-none flex items-center justify-center\">\n        <div className=\"w-80 h-80 rounded-full bg-gradient-to-tr from-[#EAE3D2]/30 via-transparent to-[#D17A5D]/10 blur-3xl opacity-60\" />\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useEffect, useRef } from \'react\';\nimport * as THREE from \'three\';\n\nexport const Hero3D: React.FC = () => {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    if (!containerRef.current) return;\n\n    const container = containerRef.current;\n    const width = container.clientWidth;\n    const height = container.clientHeight;\n\n    // 1. Scene setup\n    const scene = new THREE.Scene();\n    scene.fog = new THREE.FogExp2(0xF5F2ED, 0.06);\n\n    // 2. Camera setup\n    const camera = new THREE.PerspectiveCamera(36, width / height, 0.1, 100);\n    camera.position.set(0, 0.2, 7.2);\n\n    // 3. Renderer setup\n    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n    renderer.setSize(width, height);\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n    renderer.shadowMap.enabled = true;\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\n    renderer.toneMappingExposure = 1.15;\n\n    container.appendChild(renderer.domElement);\n\n    // 4. Studio Lighting Setup (Warm gourmet atmosphere)\n    const ambientLight = new THREE.AmbientLight(0xFFFAF2, 1.4);\n    scene.add(ambientLight);\n\n    // Main studio key light (Warm direction light)\n    const keyLight = new THREE.DirectionalLight(0xFFF4E5, 2.5);\n    keyLight.position.set(4, 7, 5);\n    keyLight.castShadow = true;\n    keyLight.shadow.mapSize.width = 2048;\n    keyLight.shadow.mapSize.height = 2048;\n    keyLight.shadow.camera.near = 0.5;\n    keyLight.shadow.camera.far = 15;\n    keyLight.shadow.bias = -0.0003;\n    scene.add(keyLight);\n\n    // Terracotta warm rim light from back-left\n    const rimLight = new THREE.DirectionalLight(0xD27D56, 1.2);\n    rimLight.position.set(-5, 2, -4);\n    scene.add(rimLight);\n\n    // Soft sage fill light\n    const fillLight = new THREE.PointLight(0x5A5A40, 0.9, 10);\n    fillLight.position.set(-3, 3, 3);\n    scene.add(fillLight);\n\n    // Highlight light over food\n    const foodSpot = new THREE.PointLight(0xFFE8D0, 1.5, 6);\n    foodSpot.position.set(0, 3, 2);\n    scene.add(foodSpot);\n\n    // 5. Procedural Textures for Realism\n    // Pastry Texture for Wellington\n    const createPastryTexture = () => {\n      const canvas = document.createElement(\'canvas\');\n      canvas.width = 256;\n      canvas.height = 256;\n      const ctx = canvas.getContext(\'2d\');\n      if (ctx) {\n        ctx.fillStyle = \'#C68E51\';\n        ctx.fillRect(0, 0, 256, 256);\n        ctx.strokeStyle = \'#8B5324\';\n        ctx.lineWidth = 5;\n        for (let i = -256; i < 512; i += 20) {\n          ctx.beginPath();\n          ctx.moveTo(i, 0);\n          ctx.lineTo(i + 256, 256);\n          ctx.stroke();\n          ctx.beginPath();\n          ctx.moveTo(i, 256);\n          ctx.lineTo(i + 256, 0);\n          ctx.stroke();\n        }\n        ctx.fillStyle = \'#E3B272\';\n        for (let i = 0; i < 40; i++) {\n          ctx.beginPath();\n          ctx.arc(Math.random() * 256, Math.random() * 256, Math.random() * 5, 0, Math.PI * 2);\n          ctx.fill();\n        }\n      }\n      const tex = new THREE.CanvasTexture(canvas);\n      tex.wrapS = THREE.RepeatWrapping;\n      tex.wrapT = THREE.RepeatWrapping;\n      tex.repeat.set(2, 2);\n      return tex;\n    };\n\n    // Caramelized sugar texture for Cr\303\250me Br\303\273l\303\251e\n    const createCaramelTexture = () => {\n      const canvas = document.createElement(\'canvas\');\n      canvas.width = 256;\n      canvas.height = 256;\n      const ctx = canvas.getContext(\'2d\');\n      if (ctx) {\n        const grad = ctx.createRadialGradient(128, 128, 10, 128, 128, 128);\n        grad.addColorStop(0, \'#F4A236\');\n        grad.addColorStop(0.6, \'#B86214\');\n        grad.addColorStop(1, \'#5C2203\');\n        ctx.fillStyle = grad;\n        ctx.fillRect(0, 0, 256, 256);\n\n        ctx.strokeStyle = \'#381301\';\n        ctx.lineWidth = 2.5;\n        for (let i = 0; i < 25; i++) {\n          ctx.beginPath();\n          ctx.moveTo(Math.random() * 256, Math.random() * 256);\n          ctx.lineTo(Math.random() * 256, Math.random() * 256);\n          ctx.stroke();\n        }\n      }\n      return new THREE.CanvasTexture(canvas);\n    };\n\n    const pastryTex = createPastryTexture();\n    const caramelTex = createCaramelTexture();\n\n    // Shared Materials\n    const ceramicMat = new THREE.MeshStandardMaterial({\n      color: 0xFAF8F5,\n      roughness: 0.12,\n      metalness: 0.05,\n    });\n\n    const goldMat = new THREE.MeshStandardMaterial({\n      color: 0xD4AF37,\n      roughness: 0.2,\n      metalness: 0.9,\n    });\n\n    const silverMat = new THREE.MeshStandardMaterial({\n      color: 0xE0E0E0,\n      roughness: 0.15,\n      metalness: 0.95,\n    });\n\n    const beefCenterMat = new THREE.MeshStandardMaterial({\n      color: 0x801818, // Rich juicy pink/red beef core\n      roughness: 0.35,\n      metalness: 0.05,\n    });\n\n    const duxellesMat = new THREE.MeshStandardMaterial({\n      color: 0x30221A, // Dark mushroom duxelles layer\n      roughness: 0.7,\n    });\n\n    const pastryMat = new THREE.MeshStandardMaterial({\n      map: pastryTex,\n      roughness: 0.5,\n      metalness: 0.0,\n    });\n\n    const risottoMat = new THREE.MeshStandardMaterial({\n      color: 0xF2EAD8, // Creamy risotto\n      roughness: 0.4,\n      metalness: 0.0,\n    });\n\n    const wineSauceMat = new THREE.MeshStandardMaterial({\n      color: 0x3D0C13, // Deep glossy red wine reduction\n      roughness: 0.05,\n      metalness: 0.1,\n    });\n\n    const herbMat = new THREE.MeshStandardMaterial({\n      color: 0x3A522A, // Fresh dark green herb/rosemary\n      roughness: 0.4,\n    });\n\n    const glassMat = new THREE.MeshPhysicalMaterial({\n      color: 0xFFFFFF,\n      transparent: true,\n      opacity: 0.3,\n      roughness: 0.08,\n      transmission: 0.9,\n      thickness: 0.8,\n      ior: 1.5,\n    });\n\n    const berryMat = new THREE.MeshStandardMaterial({\n      color: 0xB51A30,\n      roughness: 0.25,\n      metalness: 0.05,\n    });\n\n    const caramelMat = new THREE.MeshStandardMaterial({\n      map: caramelTex,\n      roughness: 0.15,\n      metalness: 0.1,\n    });\n\n    // 6. Dishes Container\n    const dishesGroup = new THREE.Group();\n    scene.add(dishesGroup);\n\n    // ==========================================\n    // DISH 1: FILETER WELLINGTON CON RISOTTO (Centro Principal)\n    // ==========================================\n    const wellingtonGroup = new THREE.Group();\n\n    // Modern wide ceramic plate\n    const plateGeo = new THREE.CylinderGeometry(1.5, 0.9, 0.14, 64);\n    const plate = new THREE.Mesh(plateGeo, ceramicMat);\n    plate.castShadow = true;\n    plate.receiveShadow = true;\n    wellingtonGroup.add(plate);\n\n    // Gold rim accent line\n    const plateRimGeo = new THREE.TorusGeometry(1.45, 0.015, 16, 64);\n    const plateRim = new THREE.Mesh(plateRimGeo, goldMat);\n    plateRim.rotation.x = Math.PI / 2;\n    plateRim.position.y = 0.071;\n    wellingtonGroup.add(plateRim);\n\n    // Pool of Red Wine Sauce Reduction\n    const sauceGeo = new THREE.CylinderGeometry(1.1, 1.1, 0.015, 48);\n    const sauce = new THREE.Mesh(sauceGeo, wineSauceMat);\n    sauce.position.y = 0.076;\n    wellingtonGroup.add(sauce);\n\n    // Bed of Creamy Mushroom Risotto\n    const risottoGeo = new THREE.CylinderGeometry(0.85, 0.9, 0.12, 48);\n    const risotto = new THREE.Mesh(risottoGeo, risottoMat);\n    risotto.position.y = 0.13;\n    risotto.castShadow = true;\n    risotto.receiveShadow = true;\n    wellingtonGroup.add(risotto);\n\n    // Risotto texture details (small rice grains)\n    for (let i = 0; i < 18; i++) {\n      const grainGeo = new THREE.CapsuleGeometry(0.025, 0.05, 4, 8);\n      const grain = new THREE.Mesh(grainGeo, risottoMat);\n      const a = Math.random() * Math.PI * 2;\n      const r = Math.random() * 0.7;\n      grain.position.set(Math.cos(a) * r, 0.2, Math.sin(a) * r);\n      grain.rotation.set(Math.random(), Math.random(), Math.random());\n      wellingtonGroup.add(grain);\n    }\n\n    // --- FILETE WELLINGTON (Sliced Slice) ---\n    const wellingtonSlice = new THREE.Group();\n\n    // Outer Pastry Shell\n    const pastryGeo = new THREE.CylinderGeometry(0.5, 0.5, 0.4, 32, 1, false, 0, Math.PI * 1.3);\n    const pastry = new THREE.Mesh(pastryGeo, pastryMat);\n    pastry.castShadow = true;\n    wellingtonSlice.add(pastry);\n\n    // Mushroom Duxelles Layer\n    const duxellesGeo = new THREE.CylinderGeometry(0.44, 0.44, 0.4, 32, 1, false, 0, Math.PI * 1.3);\n    const duxelles = new THREE.Mesh(duxellesGeo, duxellesMat);\n    duxelles.position.y = 0.001;\n    wellingtonSlice.add(duxelles);\n\n    // Juicy Beef Center Core\n    const beefGeo = new THREE.CylinderGeometry(0.38, 0.38, 0.402, 32);\n    const beef = new THREE.Mesh(beefGeo, beefCenterMat);\n    beef.castShadow = true;\n    wellingtonSlice.add(beef);\n\n    // Position Wellington on risotto bed\n    wellingtonSlice.rotation.x = Math.PI / 2;\n    wellingtonSlice.rotation.z = -0.3;\n    wellingtonSlice.position.set(-0.1, 0.32, 0.05);\n    wellingtonGroup.add(wellingtonSlice);\n\n    // Rosemary Sprig & Microgreens Garnish\n    const stemGeo = new THREE.CylinderGeometry(0.012, 0.012, 0.6, 8);\n    const stem = new THREE.Mesh(stemGeo, herbMat);\n    stem.rotation.z = 1.1;\n    stem.rotation.x = 0.3;\n    stem.position.set(0.2, 0.42, 0.2);\n    wellingtonGroup.add(stem);\n\n    for (let i = 0; i < 10; i++) {\n      const leafGeo = new THREE.ConeGeometry(0.02, 0.1, 4);\n      const leaf = new THREE.Mesh(leafGeo, herbMat);\n      leaf.position.set(\n        0.2 + (Math.random() - 0.5) * 0.3,\n        0.42 + Math.random() * 0.05,\n        0.2 + (Math.random() - 0.5) * 0.3\n      );\n      leaf.rotation.set(Math.random(), Math.random(), Math.random());\n      wellingtonGroup.add(leaf);\n    }\n\n    wellingtonGroup.position.set(-0.25, -0.35, 0.3);\n    wellingtonGroup.rotation.x = 0.48;\n    wellingtonGroup.rotation.z = -0.08;\n    dishesGroup.add(wellingtonGroup);\n\n    // ==========================================\n    // DISH 2: CLOCHE Y BANDEJA DE PRESENTACI\303\223N (Arriba Derecha)\n    // ==========================================\n    const clocheGroup = new THREE.Group();\n\n    // Polished Silver Platter Platter\n    const trayGeo = new THREE.CylinderGeometry(1.0, 0.6, 0.08, 48);\n    const tray = new THREE.Mesh(trayGeo, silverMat);\n    tray.castShadow = true;\n    tray.receiveShadow = true;\n    clocheGroup.add(tray);\n\n    const trayRimGeo = new THREE.TorusGeometry(0.98, 0.02, 16, 48);\n    const trayRim = new THREE.Mesh(trayRimGeo, goldMat);\n    trayRim.rotation.x = Math.PI / 2;\n    trayRim.position.y = 0.041;\n    clocheGroup.add(trayRim);\n\n    // Glass Cloche Cover Dome\n    const domeGeo = new THREE.SphereGeometry(0.72, 32, 24, 0, Math.PI * 2, 0, Math.PI * 0.5);\n    const dome = new THREE.Mesh(domeGeo, glassMat);\n    dome.position.y = 0.04;\n    clocheGroup.add(dome);\n\n    // Glass/Gold Handle Knob on Cloche\n    const knobGeo = new THREE.SphereGeometry(0.1, 16, 16);\n    const knob = new THREE.Mesh(knobGeo, goldMat);\n    knob.position.y = 0.76;\n    clocheGroup.add(knob);\n\n    // Inside appetizer / glowing tasting bite\n    const biteGeo = new THREE.DodecahedronGeometry(0.2, 1);\n    const biteMat = new THREE.MeshStandardMaterial({ color: 0xD27D56, roughness: 0.3 });\n    const bite = new THREE.Mesh(biteGeo, biteMat);\n    bite.position.y = 0.2;\n    bite.castShadow = true;\n    clocheGroup.add(bite);\n\n    clocheGroup.position.set(1.55, 0.85, -0.3);\n    clocheGroup.rotation.x = 0.55;\n    clocheGroup.rotation.y = -0.25;\n    dishesGroup.add(clocheGroup);\n\n    // ==========================================\n    // DISH 3: CR\303\210ME BR\303\233L\303\211E EN RAMEQU\303\215N Y FRAMBUESAS (Abajo Izquierda)\n    // ==========================================\n    const bruleeGroup = new THREE.Group();\n\n    // Ceramic Fluted Ramekin\n    const ramekinGeo = new THREE.CylinderGeometry(0.65, 0.55, 0.4, 32);\n    const ramekin = new THREE.Mesh(ramekinGeo, ceramicMat);\n    ramekin.castShadow = true;\n    ramekin.receiveShadow = true;\n    bruleeGroup.add(ramekin);\n\n    // Caramelized Torched Sugar Top Surface\n    const caramelGeo = new THREE.CylinderGeometry(0.61, 0.61, 0.02, 32);\n    const caramel = new THREE.Mesh(caramelGeo, caramelMat);\n    caramel.position.y = 0.18;\n    caramel.receiveShadow = true;\n    bruleeGroup.add(caramel);\n\n    // Fresh Raspberry Garnishes\n    for (let i = 0; i < 3; i++) {\n      const berryGroup = new THREE.Group();\n      // Composite berry made of tiny drupelets\n      for (let j = 0; j < 12; j++) {\n        const dGeo = new THREE.SphereGeometry(0.022, 8, 8);\n        const drupelet = new THREE.Mesh(dGeo, berryMat);\n        const angle = (j / 12) * Math.PI * 2;\n        drupelet.position.set(Math.cos(angle) * 0.03, (j % 3) * 0.015, Math.sin(angle) * 0.03);\n        berryGroup.add(drupelet);\n      }\n      const angle = (i / 3) * Math.PI * 2;\n      berryGroup.position.set(Math.cos(angle) * 0.2, 0.22, Math.sin(angle) * 0.2);\n      bruleeGroup.add(berryGroup);\n    }\n\n    // Fresh Mint Leaf\n    const leafShape = new THREE.Shape();\n    leafShape.moveTo(0, 0);\n    leafShape.quadraticCurveTo(0.1, 0.1, 0.2, 0);\n    leafShape.quadraticCurveTo(0.1, -0.1, 0, 0);\n    const extrudeSettings = { depth: 0.005, bevelEnabled: false };\n    const mintGeo = new THREE.ExtrudeGeometry(leafShape, extrudeSettings);\n    const mintLeaf = new THREE.Mesh(mintGeo, herbMat);\n    mintLeaf.rotation.x = Math.PI / 2;\n    mintLeaf.position.set(0, 0.23, 0);\n    bruleeGroup.add(mintLeaf);\n\n    // Gold Dessert Spoon resting beside ramekin\n    const spoonHandleGeo = new THREE.CylinderGeometry(0.01, 0.015, 0.7, 8);\n    const spoonHandle = new THREE.Mesh(spoonHandleGeo, goldMat);\n    spoonHandle.rotation.z = 1.3;\n    spoonHandle.rotation.x = 0.2;\n    spoonHandle.position.set(0.55, 0.05, 0.1);\n    bruleeGroup.add(spoonHandle);\n\n    const spoonBowlGeo = new THREE.SphereGeometry(0.08, 16, 12, 0, Math.PI * 2, 0, Math.PI * 0.5);\n    const spoonBowl = new THREE.Mesh(spoonBowlGeo, goldMat);\n    spoonBowl.rotation.x = -Math.PI / 2;\n    spoonBowl.position.set(0.2, 0.05, 0.3);\n    bruleeGroup.add(spoonBowl);\n\n    bruleeGroup.position.set(-1.65, 0.65, -0.5);\n    bruleeGroup.rotation.x = 0.45;\n    bruleeGroup.rotation.y = 0.35;\n    dishesGroup.add(bruleeGroup);\n\n    // Floor Shadow Receiver\n    const shadowPlaneGeo = new THREE.PlaneGeometry(14, 14);\n    const shadowPlaneMat = new THREE.ShadowMaterial({ opacity: 0.07 });\n    const shadowPlane = new THREE.Mesh(shadowPlaneGeo, shadowPlaneMat);\n    shadowPlane.rotation.x = -Math.PI / 2;\n    shadowPlane.position.y = -2.0;\n    shadowPlane.receiveShadow = true;\n    scene.add(shadowPlane);\n\n    // 7. Interactive Parallax & Animation Loop\n    let mouseX = 0;\n    let mouseY = 0;\n    let targetX = 0;\n    let targetY = 0;\n\n    const handleMouseMove = (e: MouseEvent) => {\n      const rect = container.getBoundingClientRect();\n      const x = (e.clientX - rect.left) / rect.width - 0.5;\n      const y = (e.clientY - rect.top) / rect.height - 0.5;\n      targetX = x * 0.7;\n      targetY = y * 0.7;\n    };\n\n    window.addEventListener(\'mousemove\', handleMouseMove);\n\n    let animationFrameId: number;\n    let clock = new THREE.Clock();\n\n    const animate = () => {\n      animationFrameId = requestAnimationFrame(animate);\n      const elapsedTime = clock.getElapsedTime();\n\n      // Smooth mouse interpolation\n      mouseX += (targetX - mouseX) * 0.05;\n      mouseY += (targetY - mouseY) * 0.05;\n\n      // Group subtle hover rotation\n      dishesGroup.rotation.y = mouseX * 0.4 + Math.sin(elapsedTime * 0.2) * 0.04;\n      dishesGroup.rotation.x = -mouseY * 0.25 + Math.cos(elapsedTime * 0.15) * 0.03;\n\n      // Gentle floating motions for each gourmet presentation\n      wellingtonGroup.position.y = -0.35 + Math.sin(elapsedTime * 1.1) * 0.06;\n      wellingtonGroup.rotation.y = Math.sin(elapsedTime * 0.4) * 0.08;\n\n      clocheGroup.position.y = 0.85 + Math.sin(elapsedTime * 0.85 + 1) * 0.08;\n      clocheGroup.rotation.z = Math.cos(elapsedTime * 0.5) * 0.05;\n\n      bruleeGroup.position.y = 0.65 + Math.sin(elapsedTime * 1.0 + 2) * 0.07;\n      bruleeGroup.rotation.x = 0.45 + Math.sin(elapsedTime * 0.6) * 0.04;\n\n      renderer.render(scene, camera);\n    };\n\n    animate();\n\n    // 8. Resize Handler\n    const handleResize = () => {\n      if (!containerRef.current) return;\n      const w = containerRef.current.clientWidth;\n      const h = containerRef.current.clientHeight;\n      camera.aspect = w / h;\n      camera.updateProjectionMatrix();\n      renderer.setSize(w, h);\n    };\n\n    window.addEventListener(\'resize\', handleResize);\n\n    // Cleanup\n    return () => {\n      window.removeEventListener(\'mousemove\', handleMouseMove);\n      window.removeEventListener(\'resize\', handleResize);\n      cancelAnimationFrame(animationFrameId);\n\n      // Dispose resources\n      [plateGeo, plateRimGeo, sauceGeo, risottoGeo, pastryGeo, duxellesGeo, beefGeo, stemGeo, trayGeo, trayRimGeo, domeGeo, knobGeo, biteGeo, ramekinGeo, caramelGeo, spoonHandleGeo, spoonBowlGeo, shadowPlaneGeo].forEach(g => g.dispose());\n      [ceramicMat, goldMat, silverMat, beefCenterMat, duxellesMat, pastryMat, risottoMat, wineSauceMat, herbMat, glassMat, berryMat, caramelMat, shadowPlaneMat].forEach(m => m.dispose());\n      pastryTex.dispose();\n      caramelTex.dispose();\n      renderer.dispose();\n\n      if (container && renderer.domElement && container.contains(renderer.domElement)) {\n        container.removeChild(renderer.domElement);\n      }\n    };\n  }, []);\n\n  return (\n    <div \n      ref={containerRef} \n      className=\"w-full h-[440px] md:h-[560px] relative flex items-center justify-center overflow-hidden cursor-grab active:cursor-grabbing\"\n      aria-label=\"Escena 3D interactiva de gastronom\303\255a Maceiras con Filete Wellington, Cr\303\250me Br\303\273l\303\251e y Cloche\"\n    >\n      {/* Glow ambiental c\303\241lido de fondo */}\n      <div className=\"absolute inset-0 pointer-events-none flex items-center justify-center\">\n        <div className=\"w-80 h-80 rounded-full bg-gradient-to-tr from-[#EADDCA]/30 via-transparent to-[#D27D56]/15 blur-3xl opacity-70\" />\n      </div>\n    </div>\n  );\n};\n"
    }
