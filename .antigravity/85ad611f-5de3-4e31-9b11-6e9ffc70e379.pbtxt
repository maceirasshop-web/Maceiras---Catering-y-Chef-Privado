        }
        lines {
          text: "    const knobGeo = new THREE.SphereGeometry(0.1, 16, 16);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const knob = new THREE.Mesh(knobGeo, goldTrimMat);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    knob.position.y = 0.74;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    plate2Group.add(knob);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    plate2Group.position.set(1.5, 0.9, -0.4);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    plate2Group.rotation.x = 0.6;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    plate2Group.rotation.y = -0.2;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    dishesGroup.add(plate2Group);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // --- DISH 3: Artisanal Ceramic Tasting Vessel (Bottom Left) ---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const plate3Group = new THREE.Group();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const bowlGeo = new THREE.CylinderGeometry(0.65, 0.35, 0.45, 32);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const bowl = new THREE.Mesh(bowlGeo, ceramicMat);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    bowl.castShadow = true;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    bowl.receiveShadow = true;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    plate3Group.add(bowl);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Inner liquid / glaze"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const liquidGeo = new THREE.CylinderGeometry(0.6, 0.6, 0.02, 32);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const liquidMat = new THREE.MeshStandardMaterial({"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      color: 0x3A4335,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      roughness: 0.1,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
