  file_change {
    absolute_path_uri: "file:///src/components/ContactSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "    <section id=\"contacto\" className=\"py-28 bg-[#FAF8F5] relative border-t border-[#EAE3D2]/50\">\n      <div className=\"max-w-4xl mx-auto px-6 lg:px-12\">\n        \n        {/* Header de la secci\303\263n centrado y limpio */}\n        <div className=\"text-center max-w-xl mx-auto mb-16 space-y-4\">\n          <span className=\"text-xs uppercase tracking-widest text-[#C86D51] font-medium font-sans\">\n            Atenci\303\263n Personalizada\n          </span>\n          <h2 className=\"font-serif text-3xl sm:text-5xl text-[#2C3527] font-normal leading-tight\">\n            Dise\303\261emos tu velada\n          </h2>\n          <p className=\"text-[#5C6654] font-sans font-light text-base leading-relaxed\">\n            Completa el formulario para recibir una propuesta gastron\303\263mica a medida en menos de 24 horas.\n          </p>\n        </div>\n\n        {/* Contenedor del Formulario limpio y centrado */}\n        <motion.div \n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          transition={{ duration: 0.6 }}\n          className=\"bg-[#FDFBF7] p-8 sm:p-12 rounded-3xl border border-[#EAE3D2] shadow-sm relative overflow-hidden\"\n        >\n          {submitted ? (\n            <div className=\"py-12 text-center space-y-6\">\n              <div className=\"w-16 h-16 rounded-full bg-[#3A4335] text-[#FAF8F5] flex items-center justify-center mx-auto\">\n                <CheckCircle2 className=\"w-8 h-8 text-[#FAF8F5]\" />\n              </div>\n              <div className=\"space-y-2\">\n                <h3 className=\"font-serif text-2xl sm:text-3xl text-[#2C3527]\">\n                  Solicitud recibida con \303\251xito\n                </h3>\n                <p className=\"text-sm text-[#5C6654] font-light max-w-md mx-auto\">\n                  Gracias, {formData.name}. Nuestro Ma\303\256tre & Chef Ejecutivo revisar\303\241 tus requerimientos para enviarte un men\303\272 detallado a <span className=\"font-medium text-[#2C3527]\">{formData.email}</span>.\n                </p>\n              </div>\n\n              <div className=\"p-6 rounded-2xl bg-[#FAF8F5] border border-[#EAE3D2] max-w-md mx-auto text-left space-y-2 text-xs text-[#5C6654]\">\n                <div className=\"flex justify-between\">\n                  <span className=\"text-[#8C7A6B]\">Tipo de evento:</span>\n                  <span className=\"font-medium text-[#2C3527]\">{formData.eventType}</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-[#8C7A6B]\">Comensales estimados:</span>\n                  <span className=\"font-medium text-[#2C3527]\">{formData.guestCount} personas</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-[#8C7A6B]\">Estimaci\303\263n orientativa:</span>\n                  <span className=\"font-medium text-[#C86D51]\">~ {getEstimatedPrice().toLocaleString(\'es-ES\')} \342\202\254</span>\n                </div>\n              </div>\n\n              <button\n                onClick={() => {\n                  setSubmitted(false);\n                  setFormData({\n                    name: \'\',\n                    email: \'\',\n                    phone: \'\',\n                    eventType: \'Chef Privado a Domicilio\',\n                    guestCount: 6,\n                    date: \'\',\n                    location: \'\',\n                    dietaryNotes: \'\',\n                    message: \'\'\n                  });\n                }}\n                className=\"px-8 py-3 rounded-full bg-[#3A4335] text-[#FAF8F5] text-xs uppercase tracking-widest font-medium hover:bg-[#C86D51] transition-colors\"\n              >\n                Enviar otra consulta\n              </button>\n            </div>\n          ) : (\n            <form onSubmit={handleSubmit} className=\"space-y-8\">\n              \n              {/* Bloque 1: Datos Personales */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                <div className=\"space-y-2\">\n                  <label htmlFor=\"name\" className=\"block text-xs uppercase tracking-wider text-[#3A4335] font-medium font-sans\">\n                    Nombre completo <span className=\"text-[#C86D51]\">*</span>\n                  </label>\n                  <input\n                    type=\"text\"\n                    id=\"name\"\n                    name=\"name\"\n                    required\n                    value={formData.name}\n                    onChange={handleChange}\n                    placeholder=\"Ej. Mar\303\255a Garc\303\255a\"\n                    className=\"w-full px-4 py-3 rounded-xl bg-[#FAF8F5] border border-[#EAE3D2] text-[#2C3527] text-sm focus:outline-none focus:border-[#C86D51] focus:ring-1 focus:ring-[#C86D51] transition-all\"\n                  />\n                </div>\n\n                <div className=\"space-y-2\">\n                  <label htmlFor=\"email\" className=\"block text-xs uppercase tracking-wider text-[#3A4335] font-medium font-sans\">\n                    Correo electr\303\263nico <span className=\"text-[#C86D51]\">*</span>\n                  </label>\n                  <input\n                    type=\"email\"\n                    id=\"email\"\n                    name=\"email\"\n                    required\n                    value={formData.email}\n                    onChange={handleChange}\n                    placeholder=\"ejemplo@correo.com\"\n                    className=\"w-full px-4 py-3 rounded-xl bg-[#FAF8F5] border border-[#EAE3D2] text-[#2C3527] text-sm focus:outline-none focus:border-[#C86D51] focus:ring-1 focus:ring-[#C86D51] transition-all\"\n                  />\n                </div>\n              </div>\n\n              {/* Bloque 2: Detalles del Evento */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-6\">\n                <div className=\"space-y-2 sm:col-span-1\">\n                  <label htmlFor=\"eventType\" className=\"block text-xs uppercase tracking-wider text-[#3A4335] font-medium font-sans\">\n                    Tipo de evento <span className=\"text-[#C86D51]\">*</span>\n                  </label>\n                  <select\n                    id=\"eventType\"\n                    name=\"eventType\"\n                    value={formData.eventType}\n                    onChange={handleChange}\n                    className=\"w-full px-4 py-3 rounded-xl bg-[#FAF8F5] border border-[#EAE3D2] text-[#2C3527] text-sm focus:outline-none focus:border-[#C86D51] transition-all cursor-pointer\"\n                  >\n                    <option value=\"Chef Privado a Domicilio\">Chef Privado a Domicilio</option>\n                    <option value=\"Catering Premium para Eventos\">Catering Premium (Bodas/Social)</option>\n                    <option value=\"Eventos Corporativos & Ejecutivos\">Eventos Corporativos VIP</option>\n                    <option value=\"Experiencia de Catas & Maridaje\">Catas Privadas & Sommelier</option>\n                  </select>\n                </div>\n\n                <div className=\"space-y-2\">\n                  <label htmlFor=\"guestCount\" className=\"block text-xs uppercase tracking-wider text-[#3A4335] font-medium font-sans\">\n                    N\302\272 de comensales\n                  </label>\n                  <input\n                    type=\"number\"\n                    id=\"guestCount\"\n                    name=\"guestCount\"\n                    min=\"1\"\n                    max=\"300\"\n                    value={formData.guestCount}\n                    onChange={handleChange}\n                    className=\"w-full px-4 py-3 rounded-xl bg-[#FAF8F5] border border-[#EAE3D2] text-[#2C3527] text-sm focus:outline-none focus:border-[#C86D51] transition-all\"\n                  />\n                </div>\n\n                <div className=\"space-y-2\">\n                  <label htmlFor=\"phone\" className=\"block text-xs uppercase tracking-wider text-[#3A4335] font-medium font-sans\">\n                    Tel\303\251fono / WhatsApp\n                  </label>\n                  <input\n                    type=\"tel\"\n                    id=\"phone\"\n                    name=\"phone\"\n                    value={formData.phone}\n                    onChange={handleChange}\n                    placeholder=\"+34 600 000 000\"\n                    className=\"w-full px-4 py-3 rounded-xl bg-[#FAF8F5] border border-[#EAE3D2] text-[#2C3527] text-sm focus:outline-none focus:border-[#C86D51] transition-all\"\n                  />\n                </div>\n              </div>\n\n              {/* Bloque 3: Fecha & Ubicaci\303\263n opcional */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                <div className=\"space-y-2\">\n                  <label htmlFor=\"date\" className=\"block text-xs uppercase tracking-wider text-[#3A4335] font-medium font-sans\">\n                    Fecha estimada\n                  </label>\n                  <input\n                    type=\"date\"\n                    id=\"date\"\n                    name=\"date\"\n                    value={formData.date}\n                    onChange={handleChange}\n                    className=\"w-full px-4 py-3 rounded-xl bg-[#FAF8F5] border border-[#EAE3D2] text-[#2C3527] text-sm focus:outline-none focus:border-[#C86D51] transition-all\"\n                  />\n                </div>\n\n                <div className=\"space-y-2\">\n                  <label htmlFor=\"location\" className=\"block text-xs uppercase tracking-wider text-[#3A4335] font-medium font-sans\">\n                    Ubicaci\303\263n / Ciudad\n                  </label>\n                  <input\n                    type=\"text\"\n                    id=\"location\"\n                    name=\"location\"\n                    value={formData.location}\n                    onChange={handleChange}\n                    placeholder=\"Ej. Madrid, Barcelona, Marbella...\"\n                    className=\"w-full px-4 py-3 rounded-xl bg-[#FAF8F5] border border-[#EAE3D2] text-[#2C3527] text-sm focus:outline-none focus:border-[#C86D51] transition-all\"\n                  />\n                </div>\n              </div>\n\n              {/* Mensaje */}\n              <div className=\"space-y-2\">\n                <label htmlFor=\"message\" className=\"block text-xs uppercase tracking-wider text-[#3A4335] font-medium font-sans\">\n                  Detalles del mensaje o intolerancias\n                </label>\n                <textarea\n                  id=\"message\"\n                  name=\"message\"\n                  rows={4}\n                  value={formData.message}\n                  onChange={handleChange}\n                  placeholder=\"Cu\303\251ntanos el estilo de evento que imaginas, preferencias culinarias o necesidades especiales...\"\n                  className=\"w-full px-4 py-3 rounded-xl bg-[#FAF8F5] border border-[#EAE3D2] text-[#2C3527] text-sm focus:outline-none focus:border-[#C86D51] transition-all resize-none\"\n                />\n              </div>\n\n              {/* Gu\303\255a orientativa limpia */}\n              <div className=\"p-4 rounded-xl bg-[#FAF8F5] border border-[#EAE3D2] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#5C6654]\">\n                <div className=\"flex items-center gap-2\">\n                  <ChefHat className=\"w-4 h-4 text-[#C86D51]\" />\n                  <span>Estimaci\303\263n orientativa autom\303\241tica:</span>\n                </div>\n                <div className=\"font-serif text-lg text-[#2C3527] font-medium\">\n                  ~ {getEstimatedPrice().toLocaleString(\'es-ES\')} \342\202\254 <span className=\"text-xs font-sans text-[#8C7A6B] font-normal\">({formData.guestCount} pax)</span>\n                </div>\n              </div>\n\n              {/* Bot\303\263n de env\303\255o elegante */}\n              <div className=\"pt-2 text-center\">\n                <button\n                  type=\"submit\"\n                  disabled={loading}\n                  className=\"w-full sm:w-auto inline-flex items-center justify-center gap-3 px-10 py-4 rounded-full bg-[#3A4335] text-[#FAF8F5] text-xs uppercase tracking-widest font-medium transition-all duration-300 hover:bg-[#C86D51] hover:shadow-lg active:scale-98 cursor-pointer disabled:opacity-50\"\n                  id=\"submit-contact-btn\"\n                >\n                  {loading ? (\n                    <span>Procesando propuesta...</span>\n                  ) : (\n                    <>\n                      <span>Enviar solicitud de cotizaci\303\263n</span>\n                      <Send className=\"w-3.5 h-3.5\" />\n                    </>\n                  )}\n                </button>\n              </div>\n\n            </form>\n          )}\n\n        </motion.div>\n\n        {/* Canales directos de contacto */}\n        <div className=\"mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 text-center text-xs text-[#5C6654]\">\n          <div className=\"p-6 rounded-2xl bg-[#FDFBF7] border border-[#EAE3D2] space-y-2\">\n            <Phone className=\"w-5 h-5 mx-auto text-[#C86D51]\" />\n            <div className=\"font-medium text-[#2C3527]\">Atenci\303\263n Telef\303\263nica</div>\n            <div>+34 600 000 000</div>\n          </div>\n          <div className=\"p-6 rounded-2xl bg-[#FDFBF7] border border-[#EAE3D2] space-y-2\">\n            <Mail className=\"w-5 h-5 mx-auto text-[#C86D51]\" />\n            <div className=\"font-medium text-[#2C3527]\">Correo Electr\303\263nico</div>\n            <div>reservas@saborvivo.com</div>\n          </div>\n          <div className=\"p-6 rounded-2xl bg-[#FDFBF7] border border-[#EAE3D2] space-y-2\">\n            <MapPin className=\"w-5 h-5 mx-auto text-[#C86D51]\" />\n            <div className=\"font-medium text-[#2C3527]\">Cobertura de Servicio</div>\n            <div>Madrid \302\267 Barcelona \302\267 Marbella \302\267 Balearics</div>\n          </div>\n        </div>\n\n      </div>\n    </section>"
      replacement_content: "    <section id=\"contacto\" className=\"py-28 bg-[#F5F2ED] relative border-t border-[#2A2A2A]/10\">\n      <div className=\"max-w-4xl mx-auto px-6 lg:px-12\">\n        \n        {/* Header de la secci\303\263n centrado y limpio */}\n        <div className=\"text-center max-w-xl mx-auto mb-16 space-y-4\">\n          <span className=\"text-xs uppercase tracking-widest text-[#D27D56] font-medium font-sans\">\n            Atenci\303\263n Personalizada\n          </span>\n          <h2 className=\"font-serif text-3xl sm:text-5xl text-[#2A2A2A] font-light leading-tight\">\n            Dise\303\261emos tu velada <span className=\"italic font-normal\">a medida</span>\n          </h2>\n          <p className=\"text-[#2A2A2A]/70 font-sans font-light text-base leading-relaxed\">\n            Completa el formulario para recibir una propuesta gastron\303\263mica exclusiva en menos de 24 horas.\n          </p>\n        </div>\n\n        {/* Contenedor del Formulario limpio y centrado */}\n        <motion.div \n          initial={{ opacity: 0, y: 20 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          transition={{ duration: 0.6 }}\n          className=\"bg-white p-8 sm:p-12 rounded-xs border border-[#2A2A2A]/10 card-shadow relative overflow-hidden\"\n        >\n          {submitted ? (\n            <div className=\"py-12 text-center space-y-6\">\n              <div className=\"w-16 h-16 rounded-full bg-[#5A5A40] text-[#F5F2ED] flex items-center justify-center mx-auto\">\n                <CheckCircle2 className=\"w-8 h-8 text-[#F5F2ED]\" />\n              </div>\n              <div className=\"space-y-2\">\n                <h3 className=\"font-serif text-2xl sm:text-3xl text-[#2A2A2A] font-light\">\n                  Solicitud recibida con \303\251xito\n                </h3>\n                <p className=\"text-sm text-[#2A2A2A]/70 font-light max-w-md mx-auto\">\n                  Gracias, {formData.name}. Nuestro Ma\303\256tre & Chef Ejecutivo revisar\303\241 tus requerimientos para enviarte un men\303\272 detallado a <span className=\"font-medium text-[#2A2A2A]\">{formData.email}</span>.\n                </p>\n              </div>\n\n              <div className=\"p-6 rounded-xs bg-[#F5F2ED] border border-[#2A2A2A]/10 max-w-md mx-auto text-left space-y-2 text-xs text-[#2A2A2A]/80\">\n                <div className=\"flex justify-between\">\n                  <span className=\"text-[#5A5A40]\">Tipo de evento:</span>\n                  <span className=\"font-medium text-[#2A2A2A]\">{formData.eventType}</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-[#5A5A40]\">Comensales estimados:</span>\n                  <span className=\"font-medium text-[#2A2A2A]\">{formData.guestCount} personas</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-[#5A5A40]\">Estimaci\303\263n orientativa:</span>\n                  <span className=\"font-medium text-[#D27D56]\">~ {getEstimatedPrice().toLocaleString(\'es-ES\')} \342\202\254</span>\n                </div>\n              </div>\n\n              <button\n                onClick={() => {\n                  setSubmitted(false);\n                  setFormData({\n                    name: \'\',\n                    email: \'\',\n                    phone: \'\',\n                    eventType: \'Chef Privado a Domicilio\',\n                    guestCount: 6,\n                    date: \'\',\n                    location: \'\',\n                    dietaryNotes: \'\',\n                    message: \'\'\n                  });\n                }}\n                className=\"px-8 py-3 rounded-xs bg-[#5A5A40] text-[#F5F2ED] text-xs uppercase tracking-widest font-medium hover:bg-[#D27D56] transition-colors cursor-pointer\"\n              >\n                Enviar otra consulta\n              </button>\n            </div>\n          ) : (\n            <form onSubmit={handleSubmit} className=\"space-y-8\">\n              \n              {/* Bloque 1: Datos Personales */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                <div className=\"space-y-2\">\n                  <label htmlFor=\"name\" className=\"block text-xs uppercase tracking-widest text-[#5A5A40] font-medium font-sans\">\n                    Nombre completo <span className=\"text-[#D27D56]\">*</span>\n                  </label>\n                  <input\n                    type=\"text\"\n                    id=\"name\"\n                    name=\"name\"\n                    required\n                    value={formData.name}\n                    onChange={handleChange}\n                    placeholder=\"Ej. Mar\303\255a Garc\303\255a\"\n                    className=\"w-full px-4 py-3 rounded-xs bg-[#F5F2ED] border border-[#2A2A2A]/15 text-[#2A2A2A] text-sm focus:outline-none focus:border-[#D27D56] focus:ring-1 focus:ring-[#D27D56] transition-all\"\n                  />\n                </div>\n\n                <div className=\"space-y-2\">\n                  <label htmlFor=\"email\" className=\"block text-xs uppercase tracking-widest text-[#5A5A40] font-medium font-sans\">\n                    Correo electr\303\263nico <span className=\"text-[#D27D56]\">*</span>\n                  </label>\n                  <input\n                    type=\"email\"\n                    id=\"email\"\n                    name=\"email\"\n                    required\n                    value={formData.email}\n                    onChange={handleChange}\n                    placeholder=\"ejemplo@correo.com\"\n                    className=\"w-full px-4 py-3 rounded-xs bg-[#F5F2ED] border border-[#2A2A2A]/15 text-[#2A2A2A] text-sm focus:outline-none focus:border-[#D27D56] focus:ring-1 focus:ring-[#D27D56] transition-all\"\n                  />\n                </div>\n              </div>\n\n              {/* Bloque 2: Detalles del Evento */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-6\">\n                <div className=\"space-y-2 sm:col-span-1\">\n                  <label htmlFor=\"eventType\" className=\"block text-xs uppercase tracking-widest text-[#5A5A40] font-medium font-sans\">\n                    Tipo de evento <span className=\"text-[#D27D56]\">*</span>\n                  </label>\n                  <select\n                    id=\"eventType\"\n                    name=\"eventType\"\n                    value={formData.eventType}\n                    onChange={handleChange}\n                    className=\"w-full px-4 py-3 rounded-xs bg-[#F5F2ED] border border-[#2A2A2A]/15 text-[#2A2A2A] text-sm focus:outline-none focus:border-[#D27D56] transition-all cursor-pointer\"\n                  >\n                    <option value=\"Chef Privado a Domicilio\">Chef Privado a Domicilio</option>\n                    <option value=\"Catering Premium para Eventos\">Catering Premium (Bodas/Social)</option>\n                    <option value=\"Eventos Corporativos & Ejecutivos\">Eventos Corporativos VIP</option>\n                    <option value=\"Experiencia de Catas & Maridaje\">Catas Privadas & Sommelier</option>\n                  </select>\n                </div>\n\n                <div className=\"space-y-2\">\n                  <label htmlFor=\"guestCount\" className=\"block text-xs uppercase tracking-widest text-[#5A5A40] font-medium font-sans\">\n                    N\302\272 de comensales\n                  </label>\n                  <input\n                    type=\"number\"\n                    id=\"guestCount\"\n                    name=\"guestCount\"\n                    min=\"1\"\n                    max=\"300\"\n                    value={formData.guestCount}\n                    onChange={handleChange}\n                    className=\"w-full px-4 py-3 rounded-xs bg-[#F5F2ED] border border-[#2A2A2A]/15 text-[#2A2A2A] text-sm focus:outline-none focus:border-[#D27D56] transition-all\"\n                  />\n                </div>\n\n                <div className=\"space-y-2\">\n                  <label htmlFor=\"phone\" className=\"block text-xs uppercase tracking-widest text-[#5A5A40] font-medium font-sans\">\n                    Tel\303\251fono / WhatsApp\n                  </label>\n                  <input\n                    type=\"tel\"\n                    id=\"phone\"\n                    name=\"phone\"\n                    value={formData.phone}\n                    onChange={handleChange}\n                    placeholder=\"+34 600 000 000\"\n                    className=\"w-full px-4 py-3 rounded-xs bg-[#F5F2ED] border border-[#2A2A2A]/15 text-[#2A2A2A] text-sm focus:outline-none focus:border-[#D27D56] transition-all\"\n                  />\n                </div>\n              </div>\n\n              {/* Bloque 3: Fecha & Ubicaci\303\263n opcional */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                <div className=\"space-y-2\">\n                  <label htmlFor=\"date\" className=\"block text-xs uppercase tracking-widest text-[#5A5A40] font-medium font-sans\">\n                    Fecha estimada\n                  </label>\n                  <input\n                    type=\"date\"\n                    id=\"date\"\n                    name=\"date\"\n                    value={formData.date}\n                    onChange={handleChange}\n                    className=\"w-full px-4 py-3 rounded-xs bg-[#F5F2ED] border border-[#2A2A2A]/15 text-[#2A2A2A] text-sm focus:outline-none focus:border-[#D27D56] transition-all\"\n                  />\n                </div>\n\n                <div className=\"space-y-2\">\n                  <label htmlFor=\"location\" className=\"block text-xs uppercase tracking-widest text-[#5A5A40] font-medium font-sans\">\n                    Ubicaci\303\263n / Ciudad\n                  </label>\n                  <input\n                    type=\"text\"\n                    id=\"location\"\n                    name=\"location\"\n                    value={formData.location}\n                    onChange={handleChange}\n                    placeholder=\"Ej. Madrid, Barcelona, Marbella...\"\n                    className=\"w-full px-4 py-3 rounded-xs bg-[#F5F2ED] border border-[#2A2A2A]/15 text-[#2A2A2A] text-sm focus:outline-none focus:border-[#D27D56] transition-all\"\n                  />\n                </div>\n              </div>\n\n              {/* Mensaje */}\n              <div className=\"space-y-2\">\n                <label htmlFor=\"message\" className=\"block text-xs uppercase tracking-widest text-[#5A5A40] font-medium font-sans\">\n                  Detalles del mensaje o intolerancias\n                </label>\n                <textarea\n                  id=\"message\"\n                  name=\"message\"\n                  rows={4}\n                  value={formData.message}\n                  onChange={handleChange}\n                  placeholder=\"Cu\303\251ntanos el estilo de evento que imaginas, preferencias culinarias o necesidades especiales...\"\n                  className=\"w-full px-4 py-3 rounded-xs bg-[#F5F2ED] border border-[#2A2A2A]/15 text-[#2A2A2A] text-sm focus:outline-none focus:border-[#D27D56] transition-all resize-none\"\n                />\n              </div>\n\n              {/* Gu\303\255a orientativa limpia */}\n              <div className=\"p-4 rounded-xs bg-[#F5F2ED] border border-[#2A2A2A]/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#2A2A2A]/80\">\n                <div className=\"flex items-center gap-2\">\n                  <ChefHat className=\"w-4 h-4 text-[#D27D56]\" />\n                  <span>Estimaci\303\263n orientativa autom\303\241tica:</span>\n                </div>\n                <div className=\"font-serif text-lg text-[#2A2A2A] font-light\">\n                  ~ {getEstimatedPrice().toLocaleString(\'es-ES\')} \342\202\254 <span className=\"text-xs font-sans text-[#5A5A40] font-normal\">({formData.guestCount} pax)</span>\n                </div>\n              </div>\n\n              {/* Bot\303\263n de env\303\255o elegante */}\n              <div className=\"pt-2 text-center\">\n                <button\n                  type=\"submit\"\n                  disabled={loading}\n                  className=\"w-full sm:w-auto inline-flex items-center justify-center gap-3 px-10 py-4 rounded-xs bg-[#5A5A40] text-[#F5F2ED] text-xs uppercase tracking-widest font-medium transition-all duration-300 hover:bg-[#D27D56] hover:shadow-lg active:scale-98 cursor-pointer disabled:opacity-50\"\n                  id=\"submit-contact-btn\"\n                >\n                  {loading ? (\n                    <span>Procesando propuesta...</span>\n                  ) : (\n                    <>\n                      <span>Enviar solicitud de cotizaci\303\263n</span>\n                      <Send className=\"w-3.5 h-3.5\" />\n                    </>\n                  )}\n                </button>\n              </div>\n\n            </form>\n          )}\n\n        </motion.div>\n\n        {/* Canales directos de contacto */}\n        <div className=\"mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 text-center text-xs text-[#2A2A2A]/80\">\n          <div className=\"p-6 rounded-xs bg-white border border-[#2A2A2A]/10 card-shadow space-y-2\">\n            <Phone className=\"w-5 h-5 mx-auto text-[#D27D56]\" />\n            <div className=\"font-medium text-[#2A2A2A]\">Atenci\303\263n Telef\303\263nica</div>\n            <div>+34 600 000 000</div>\n          </div>\n          <div className=\"p-6 rounded-xs bg-white border border-[#2A2A2A]/10 card-shadow space-y-2\">\n            <Mail className=\"w-5 h-5 mx-auto text-[#D27D56]\" />\n            <div className=\"font-medium text-[#2A2A2A]\">Correo Electr\303\263nico</div>\n            <div>reservas@saborvivo.com</div>\n          </div>\n          <div className=\"p-6 rounded-xs bg-white border border-[#2A2A2A]/10 card-shadow space-y-2\">\n            <MapPin className=\"w-5 h-5 mx-auto text-[#D27D56]\" />\n            <div className=\"font-medium text-[#2A2A2A]\">Cobertura de Servicio</div>\n            <div>Madrid \302\267 Barcelona \302\267 Marbella \302\267 Balearics</div>\n          </div>\n        </div>\n\n      </div>\n    </section>"
    }
