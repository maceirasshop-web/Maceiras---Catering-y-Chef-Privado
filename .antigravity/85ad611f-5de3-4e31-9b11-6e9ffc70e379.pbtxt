    instruction: "Update catering data with Maceiras brand details, dishes (Filete Wellington, Carpaccio de res, Cr\303\250me Br\303\273l\303\251e), Chilean locations and personalized service focus"
    replacement_infos {
      original_chunk {
        target_content: "import { ServiceItem, DishItem, ProcessStep, Testimonial } from \'../types\';\n\nexport const SERVICES_DATA: ServiceItem[] = [\n  {\n    id: \'chef-privado\',\n    title: \'Chef Privado a Domicilio\',\n    subtitle: \'Alta cocina en la intimidad de tu hogar\',\n    description: \'Men\303\272s degustaci\303\263n dise\303\261ados a la medida para cenas exclusivas, celebraciones \303\255ntimas y estancias de vacaciones.\',\n    detailedDescription: \'Nuestro equipo de chefs con trayectoria en restaurantes de estrella Michelin se desplaza a tu residencia o villa. Nos encargamos de la compra de productos de temporada, mise en place, maridaje con vinos de autor, servicio en mesa y dejamos tu cocina impecable.\',\n    image: \'https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&w=1000&q=80\',\n    features: [\n      \'Men\303\272 100% personalizado seg\303\272n alergias y preferencias\',\n      \'Selecci\303\263n de producto fresco y local de mercado\',\n      \'Sommelier y maridaje exclusivo opcional\',\n      \'Limpieza completa de la cocina tras el servicio\'\n    ],\n    idealFor: \'Cenas de 2 a 16 comensales, aniversarios, celebraciones especiales y estancias vacacionales.\'\n  },\n  {\n    id: \'catering-eventos\',\n    title: \'Catering Premium para Eventos\',\n    subtitle: \'Elegancia y sabor para momentos inolvidables\',\n    description: \'Servicio integral de catering de alta gastronom\303\255a para bodas boutique, celebraciones privadas y galas.\',\n    detailedDescription: \'Transformamos espacios en alta gastronom\303\255a en vivo. Desde aperitivos pasados con presentaciones arquitect\303\263nicas hasta estaciones gastron\303\263micas interactivas y cenas formalmente servidas con vajilla artesanal y manteler\303\255a fina.\',\n    image: \'https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=1000&q=80\',\n    features: [\n      \'Showcooking y estaciones tem\303\241ticas en directo\',\n      \'Dise\303\261o de mesa y montaje gastron\303\263mico conceptual\',\n      \'Personal de sala y mixolog\303\255a de autor\',\n      \'Coordinaci\303\263n de eventos y men\303\272s especiales para invitados\'\n    ],\n    idealFor: \'Bodas boutique, fiestas privadas y eventos de 20 a 150 invitados.\'\n  },\n  {\n    id: \'experiencias-corporativas\',\n    title: \'Eventos Corporativos & Ejecutivos\',\n    subtitle: \'Distinci\303\263n gastron\303\263mica para tu marca\',\n    description: \'Cocktails de empresa, lanzamientos de productos, reuniones directivas y experiencias teambuilding gastron\303\263micas.\',\n    detailedDescription: \'Elevamos la imagen de tu empresa con propuestas sobrias, refinadas y contempor\303\241neas. Ofrecemos formatos \303\241giles tipo finger food refinado, lunches ejecutivos de tres tiempos y talleres privados de cocina de autor para juntas directivas.\',\n    image: \'https://images.unsplash.com/photo-1541544741938-0af808871cc0?auto=format&fit=crop&w=1000&q=80\',\n    features: [\n      \'Formatos \303\241giles adaptados al ritmo corporativo\',\n      \'Opciones vegetarianas, veganas y keto integradas\',\n      \'Presentaci\303\263n de marca y detalles personalizados\',\n      \'Facturaci\303\263n simplificada y log\303\255stica llave en mano\'\n    ],\n    idealFor: \'Juntas directivas, presentaciones de marca y cenas corporativas VIP.\'\n  }\n];\n\nexport const DISHES_DATA: DishItem[] = [\n  {\n    id: \'dish-1\',\n    name: \'Lubina Salvaje a la Brasa de Olivo\',\n    category: \'principales\',\n    description: \'Lomo de lubina sobre crema suave de hinojo confitado, emulsi\303\263n de c\303\255tricos y aceite de oliva virgen Arbequina.\',\n    detailedDescription: \'Lubina de captura marina cocinada a la brasa suave con madera de olivo milenario. Acompa\303\261ada de una sedosa velout\303\251 de hinojo, perlas de pomelo rosa y toque crujiente de salicornia.\',\n    ingredients: [\'Lubina salvaje\', \'Hinojo confitado\', \'Pomelo rosa\', \'Aceite Arbequina\', \'Salicornia marina\'],\n    pairing: \'Chardonnay con crianza en roble, D.O. R\303\255as Baixas o Borgo\303\261a Blanco.\',\n    image: \'https://images.unsplash.com/photo-1534422298391-e4f8c172dddb?auto=format&fit=crop&w=800&q=80\',\n    tags: [\'Producto Mar\', \'Cocina de Autor\', \'Sin Gluten\'],\n    chefNote: \'La cocci\303\263n lenta en brasa permite conservar la jugosidad original de la lonja.\'\n  },\n  {\n    id: \'dish-2\',\n    name: \'Steak Tartare de Solomillo de Cerdanya\',\n    category: \'entrantes\',\n    description: \'Cortado a cuchillo en el momento, yema curada en manteca de trufa, crujiente de almid\303\263n y brotes ecol\303\263gicos.\',\n    detailedDescription: \'Maduraci\303\263n de 30 d\303\255as en corte noble, ali\303\261ado suavemente al estilo tradicional con alcaparras de Pantelleria, mostaza antigua y aceite de trufa negra de verano.\',\n    ingredients: [\'Solomillo de buey/cerdanya\', \'Yema de huevo campero\', \'Trufa negra\', \'Alcaparras Pantelleria\'],\n    pairing: \'Pinot Noir ligero o vino tinto joven D.O. Rioja Alavesa.\',\n    image: \'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80\',\n    tags: [\'Carne Noble\', \'Ali\303\261o Tradicional\'],\n    chefNote: \'El corte manual se realiza justo 10 minutos antes de emplatar para preservar textura.\'\n  },\n  {\n    id: \'dish-3\',\n    name: \'Risotto de Colmenillas y Boletos\',\n    category: \'principales\',\n    description: \'Arroz Carnaroli mantecado con queso Parmigiano Reggiano 36 meses, trufa fresca y aire de tomillo silvestre.\',\n    detailedDescription: \'Un homenaje a los bosques de oto\303\261o. Fondo concentrado de verduras asadas y setas silvestres, cremosidad natural mantecada en fr\303\255o y l\303\241minas generosas de trufa de temporada.\',\n    ingredients: [\'Arroz Carnaroli\', \'Colmenillas frescas\', \'Boletus edulis\', \'Parmigiano 36M\', \'Aire de tomillo\'],\n    pairing: \'Nebbiolo o Barolo italiano con car\303\241cter terroso.\',\n    image: \'https://images.unsplash.com/photo-1633964913295-ceb43826e7c9?auto=format&fit=crop&w=800&q=80\',\n    tags: [\'Vegetariano\', \'Cremoso\', \'Setas de Temporada\'],\n    chefNote: \'Utilizamos caldo clarificado hirviendo para un grano firme y meloso.\'\n  },\n  {\n    id: \'dish-4\',\n    name: \'Esfera de Cacao Criollo & Naranja Amarga\',\n    category: \'postres\',\n    description: \'Texturas de chocolate 72% origen Ecuador, n\303\272cleo helado de azahar y tierra crujiente de avellana de Reus.\',\n    detailedDescription: \'Postre insignia que equilibra la amargura elegante del cacao puro con la frescura c\303\255trica del mediterr\303\241neo. Se sirve acompa\303\261ado de consom\303\251 caliente de cacao servido en mesa.\',\n    ingredients: [\'Cacao Criollo 72%\', \'C\303\255tricos ecol\303\263gicos\', \'Flor de azahar\', \'Avellana Reus\'],\n    pairing: \'Oporto Tawny 10 a\303\261os o Pedro Xim\303\251nez de bodega familiar.\',\n    image: \'https://images.unsplash.com/photo-1587314168485-3236d6710814?auto=format&fit=crop&w=800&q=80\',\n    tags: [\'Postre de Autor\', \'Texturas de Cacao\'],\n    chefNote: \'Cacao \303\251tico proveniente de fincas sostenibles en Ecuador.\'\n  }\n];\n\nexport const PROCESS_STEPS: ProcessStep[] = [\n  {\n    number: \'01\',\n    title: \'Consulta Inicial\',\n    description: \'Conversamos sobre tus gustos, concepto del evento, n\303\272mero de invitados y restricciones alimentarias.\',\n    details: \'Analizamos el espacio de la cocina o localizaci\303\263n para adaptar la infraestructura necesaria.\'\n  },\n  {\n    number: \'02\',\n    title: \'Propuesta de Men\303\272\',\n    description: \'Dise\303\261amos una propuesta gastron\303\263mica exclusiva con maridaje de vinos y alternativas personalizadas.\',\n    details: \'Ajustamos cada detalle hasta lograr la armon\303\255a perfecta que imaginas para tus invitados.\'\n  },\n  {\n    number: \'03\',\n    title: \'Mise en Place & Montaje\',\n    description: \'Seleccionamos los ingredientes m\303\241s frescos del mercado matutino y preparamos la ambientaci\303\263n.\',\n    details: \'Nuestro equipo llega con antelaci\303\263n con vajilla fina, cristalera y todo el equipamiento necesario.\'\n  },\n  {\n    number: \'04\',\n    title: \'La Experiencia\',\n    description: \'Disfruta de una velada serena mientras servimos la alta cocina. Dejamos la cocina limpia e impecable.\',\n    details: \'Servicio discreto, atento y profesional para que solo te dediques a disfrutar con tus invitados.\'\n  }\n];\n\nexport const TESTIMONIALS_DATA: Testimonial[] = [\n  {\n    id: \'t1\',\n    client: \'Carlos & Elena de M.\',\n    role: \'Cena Privada Aniversario\',\n    quote: \'Sabor Vivo transform\303\263 nuestra terraza en un restaurante de estrellas Michelin. La lubina a la brasa y el maridaje fueron absolutamente memorables. Discreci\303\263n y pulcritud inmejorables.\',\n    rating: 5,\n    location: \'Madrid (La Moraleja)\'\n  },\n  {\n    id: \'t2\',\n    client: \'Beatriz S.\',\n    role: \'Celebraci\303\263n Familiar\',\n    quote: \'Lo que m\303\241s valoramos fue la calma con la que trabajaron en nuestra cocina. Dejaron todo reluciente y nuestros invitados a\303\272n recuerdan las esferas de cacao.\',\n    rating: 5,\n    location: \'Barcelona (Pedralbes)\'\n  },\n  {\n    id: \'t3\',\n    client: \'Grupo V. Executive\',\n    role: \'Junta Directiva Corporativa\',\n    quote: \'Contratamos el servicio para una reuni\303\263n ejecutiva de alto nivel. La presentaci\303\263n, puntualidad y delicadeza gastron\303\263mica superaron con creces nuestras expectativas.\',\n    rating: 5,\n    location: \'Marbella\'\n  }\n];"
        replacement_content: "import { ServiceItem, DishItem, ProcessStep, Testimonial } from \'../types\';\n\nexport const SERVICES_DATA: ServiceItem[] = [\n  {\n    id: \'chef-privado\',\n    title: \'Chef Privado a Domicilio\',\n    subtitle: \'Alta cocina en la intimidad de tu hogar\',\n    description: \'Men\303\272s dise\303\261ados a la medida para cenas exclusivas, celebraciones \303\255ntimas y eventos privados en tu residencia.\',\n    detailedDescription: \'En Maceiras nos desplazamos a tu residencia, casa de playa o centro de eventos. Nos encargamos absolutamente de todo: selecci\303\263n de ingredientes frescos de mercado, preparaci\303\263n en el lugar, servicio de mesa impecable y limpieza total de la cocina.\',\n    image: \'https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&w=1000&q=80\',\n    features: [\n      \'Men\303\272 100% personalizado para cada cliente\',\n      \'Ingredientes frescos y locales de primera calidad\',\n      \'Atenci\303\263n y servicio de mesa exclusivo\',\n      \'Limpieza impecable de la cocina al finalizar\'\n    ],\n    idealFor: \'Cenas privadas, cumplea\303\261os, aniversarios, reuniones familiares y vacaciones.\'\n  },\n  {\n    id: \'catering-eventos\',\n    title: \'Catering Premium para Eventos\',\n    subtitle: \'Elegancia y sabor adaptado a tu ocasi\303\263n\',\n    description: \'Servicio integral de catering para matrimonios boutique, eventos sociales y celebraciones familiares.\',\n    detailedDescription: \'Transformamos tu evento en una experiencia gastron\303\263mica memorable. Dise\303\261amos banquetes a la medida, cocktails elegantes y estaciones gastron\303\263micas en vivo con presentaciones cuidadas al detalle.\',\n    image: \'https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=1000&q=80\',\n    features: [\n      \'Formatos a elecci\303\263n: cena servida, cocktail o buffet exclusivo\',\n      \'Propuestas gastron\303\263micas adaptadas a tus preferencias\',\n      \'Personal de servicio profesional y discreto\',\n      \'Montaje y coordinaci\303\263n integral del men\303\272\'\n    ],\n    idealFor: \'Matrimonios, celebraciones de aniversario y eventos sociales de 15 a 150 invitados.\'\n  },\n  {\n    id: \'experiencias-corporativas\',\n    title: \'Eventos Corporativos & Ejecutivos\',\n    subtitle: \'Distinci\303\263n gastron\303\263mica para empresas\',\n    description: \'Cocktails ejecutivos, reuniones de directorio, lanzamientos de marca y cenas corporativas VIP.\',\n    detailedDescription: \'Acompa\303\261amos tus hitos empresariales con una propuesta sobria, puntual y elegante. Nos adaptamos a los tiempos de tu evento con finger food refinado, lunches ejecutivos o cenas privadas para directorios.\',\n    image: \'https://images.unsplash.com/photo-1541544741938-0af808871cc0?auto=format&fit=crop&w=1000&q=80\',\n    features: [\n      \'Men\303\272s \303\241giles para ritmo corporativo\',\n      \'Opciones especiales para restricci\303\263n alimentaria\',\n      \'Servicio profesional orientados a empresas\',\n      \'Atenci\303\263n personalizada para cada requerimiento\'\n    ],\n    idealFor: \'Reuniones de directorio, alianzas de negocios y cenas de empresa.\'\n  }\n];\n\nexport const DISHES_DATA: DishItem[] = [\n  {\n    id: \'dish-1\',\n    name: \'Filete Wellington con Risotto de Champi\303\261ones\',\n    category: \'principales\',\n    description: \'Corte noble de filete envuelto en hojaldre crujiente y duxelles de hongos, servido sobre cremoso risotto de champi\303\261ones silvestres.\',\n    detailedDescription: \'Nuestro plato insignia. Filete de res tierno sellado al punto, cubierto con una fina pat\303\251 de champi\303\261ones y envuelto en hojaldre artesanal dorado al horno. Acompa\303\261ado de un risotto de champi\303\261ones suavemente mantecado con queso artesanal.\',\n    ingredients: [\'Filete de res premium\', \'Hojaldre artesanal\', \'Duxelles de hongos\', \'Arroz Carnaroli\', \'Champi\303\261ones silvestres\', \'Reducci\303\263n de vino\'],\n    pairing: \'Cabernet Sauvignon o Carmen\303\250re de reserva del Valle del Maipo.\',\n    image: \'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80\',\n    tags: [\'Especialidad Maceiras\', \'Plato Estrella\', \'Corte Noble\'],\n    chefNote: \'El horneado del hojaldre se sincroniza exactamente para mantener el centro del filete tierno y jugoso.\'\n  },\n  {\n    id: \'dish-2\',\n    name: \'Carpaccio de Res\',\n    category: \'entrantes\',\n    description: \'Finas l\303\241minas de filete de res, alcaparras baby, escamas de queso madurado, r\303\272cula fresca y emulsi\303\263n de oliva virgen.\',\n    detailedDescription: \'Una entrada distinguida y refrescante. L\303\241minas cortadas con m\303\241xima precisi\303\263n, marinadas al instante con aceite de oliva virgen extra, jugo de lim\303\263n de pica fresco, alcaparras y un toque de pimienta reci\303\251n molida.\',\n    ingredients: [\'Filete de res fresco\', \'Queso madurado artesanal\', \'Alcaparras\', \'R\303\272cula fresca\', \'Aceite de oliva virgen extra\', \'Lim\303\263n de pica\'],\n    pairing: \'Sauvignon Blanc del Valle de Casablanca o Pinot Noir chileno.\',\n    image: \'https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=800&q=80\',\n    tags: [\'Entrante Destacado\', \'Ligero & Elegante\', \'Sin Gluten\'],\n    chefNote: \'Seleccionamos cortes magros de primera calidad para garantizar una textura suave que se deshace en la boca.\'\n  },\n  {\n    id: \'dish-3\',\n    name: \'Cr\303\250me Br\303\273l\303\251e Tradicional\',\n    category: \'postres\',\n    description: \'Crema cocida a fuego lento infusionada con vainilla natural en vaina y una fina costra de az\303\272car fogueada al instante.\',\n    detailedDescription: \'El cl\303\241sico postre franc\303\251s preparado seg\303\272n la t\303\251cnica tradicional. Una base sedosa de yemas, crema y vainilla natural con el contraste crujiente de la capa caramelizada al momento de servir.\',\n    ingredients: [\'Crema de leche fresca\', \'Yemas camperas\', \'Vaina de vainilla natural\', \'Az\303\272car caramelizada\'],\n    pairing: \'Vino Late Harvest o espumante Brut de valles chilenos.\',\n    image: \'https://images.unsplash.com/photo-1470124182917-cc6e71b22ecc?auto=format&fit=crop&w=800&q=80\',\n    tags: [\'Postre Cl\303\241sico\', \'Caramelizado al Instante\'],\n    chefNote: \'El toque de soplete se aplica segundos antes de llegar a la mesa para asegurar la m\303\241xima textura crujiente.\'\n  },\n  {\n    id: \'dish-4\',\n    name: \'Corvina del Pac\303\255fico a la Brasa con Vegetales\',\n    category: \'principales\',\n    description: \'Lomo de corvina fresca sellada a la brasa con mantequilla de hierbas nativas y vegetales org\303\241nicos glaseados.\',\n    detailedDescription: \'Pesca fresca seleccionada diariamente, cocinada a la plancha con un toque de brasa para conservar la jugosidad natural de la carne blanca. Acompa\303\261ada de vegetales de estaci\303\263n glaseados en mantequilla de romero.\',\n    ingredients: [\'Corvina del Pac\303\255fico\', \'Mantequilla de hierbas\', \'Vegetales de estaci\303\263n\', \'Aceite de oliva\', \'Flor de sal\'],\n    pairing: \'Chardonnay de clima fr\303\255o o Sauvignon Blanc de la costa.\',\n    image: \'https://images.unsplash.com/photo-1534422298391-e4f8c172dddb?auto=format&fit=crop&w=800&q=80\',\n    tags: [\'Pesca del Pac\303\255fico\', \'Vegetales Frescos\'],\n    chefNote: \'Respetamos los tiempos de pesca fresca para brindar el m\303\241ximo sabor natural del mar.\'\n  }\n];\n\nexport const PROCESS_STEPS: ProcessStep[] = [\n  {\n    number: \'01\',\n    title: \'Consulta Inicial\',\n    description: \'Conversamos sobre tus preferencias, concepto del evento, n\303\272mero de invitados y requerimientos especiales.\',\n    details: \'Servicio 100% personalizado adaptable a tus gustos e instalaciones.\'\n  },\n  {\n    number: \'02\',\n    title: \'Dise\303\261o del Men\303\272\',\n    description: \'Preparamos una propuesta de men\303\272 a tu medida con opciones de maridaje y alternativas especiales.\',\n    details: \'Ajustamos cada detalle hasta lograr la combinaci\303\263n perfecta para tu velada.\'\n  },\n  {\n    number: \'03\',\n    title: \'Preparaci\303\263n & Montaje\',\n    description: \'Seleccionamos los ingredientes m\303\241s frescos del d\303\255a y preparamos todo en tu residencia con total puntualidad.\',\n    details: \'Nuestro equipo llega con anticipaci\303\263n para cuidar cada aspecto del montaje y la cocina.\'\n  },\n  {\n    number: \'04\',\n    title: \'La Experiencia Maceiras\',\n    description: \'Disfruta de una velada inolvidable. Servimos la mesa con calidez y dejamos la cocina limpia e impecable.\',\n    details: \'Atenci\303\263n atenta y discreta para que te dediques exclusivamente a compartir con tus invitados.\'\n  }\n];\n\nexport const TESTIMONIALS_DATA: Testimonial[] = [\n  {\n    id: \'t1\',\n    client: \'Gonzalo & Camila\',\n    role: \'Cena Privada a Domicilio\',\n    quote: \'Maceiras convirti\303\263 nuestra casa en una verdadera experiencia de alta cocina. El Filete Wellington y el Carpaccio estuvieron impecables. Servicio muy profesional y cocina reluciente.\',\n    rating: 5,\n    location: \'Santiago (Lo Barnechea)\'\n  },\n  {\n    id: \'t2\',\n    client: \'Valentina R.\',\n    role: \'Aniversario Familiar\',\n    quote: \'La atenci\303\263n personalizada para cada uno de nuestros invitados hizo la diferencia. La Cr\303\250me Br\303\273l\303\251e fue el broche de oro de la noche. Totalmente recomendados.\',\n    rating: 5,\n    location: \'Vi\303\261a del Mar\'\n  },\n  {\n    id: \'t3\',\n    client: \'Familia Larra\303\255n\',\n    role: \'Celebraci\303\263n de Fin de Semana\',\n    quote: \'Contratamos el servicio de chef privado para nuestro fin de semana en la costa. Ingredientes de primera calidad y una disposici\303\263n maravillosa. Repetiremos sin duda.\',\n    rating: 5,\n    location: \'Zapallar\'\n  }\n];\n"
      }
      num_matches: 1
    }
  }
