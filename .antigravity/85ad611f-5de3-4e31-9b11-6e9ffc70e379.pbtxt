    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "@import \"tailwindcss\";\n\n@import url(\'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap\');\n\n:root {\n  --bg: #F5F2ED;\n  --ink: #2A2A2A;\n  --olive: #5A5A40;\n  --terra: #D27D56;\n  --cream: #EADDCA;\n}\n\n@layer base {\n  html {\n    scroll-behavior: smooth;\n    font-family: \'Plus Jakarta Sans\', system-ui, -apple-system, sans-serif;\n    background-color: var(--bg);\n    color: var(--ink);\n  }\n\n  h1, h2, h3, h4, .font-serif {\n    font-family: \'Georgia\', \'Cormorant Garamond\', serif;\n  }\n}\n\n.pill-tag {\n  font-size: 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  border: 1px solid rgba(42, 42, 42, 0.15);\n  padding: 4px 12px;\n  border-radius: 100px;\n}\n\n.card-shadow {\n  box-shadow: 0 8px 24px rgba(90, 90, 64, 0.06);\n}\n\n/* Custom scrollbar for clean luxury feel */\n::-webkit-scrollbar {\n  width: 8px;\n}\n::-webkit-scrollbar-track {\n  background: var(--bg);\n}\n::-webkit-scrollbar-thumb {\n  background: #D4C7B0;\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: var(--terra);\n}\n"
