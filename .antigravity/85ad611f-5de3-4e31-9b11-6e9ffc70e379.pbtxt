      replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { PROCESS_STEPS } from \'../data/cateringData\';\n\nexport const ProcessSection: React.FC = () => {\n  return (\n    <section id=\"proceso\" className=\"py-24 bg-[#FAF8F5] relative border-t border-[#EAE3D2]/50\">\n      <div className=\"max-w-7xl mx-auto px-6 lg:px-12\">\n        \n        {/* Header de la secci\303\263n */}\n        <div className=\"max-w-2xl mb-16 space-y-3\">\n          <span className=\"text-xs uppercase tracking-widest text-[#C86D51] font-medium font-sans\">\n            Metodolog\303\255a & Calma\n          </span>\n          <h2 className=\"font-serif text-3xl sm:text-4xl text-[#2C3527] font-normal leading-tight\">\n            C\303\263mo trabajamos\n          </h2>\n          <p className=\"text-[#5C6654] font-sans font-light text-base\">\n            Cuatro etapas sencillas dise\303\261adas para asegurarte la m\303\241xima tranquilidad de principio a fin.\n          </p>\n        </div>\n\n        {/* 4 pasos simples y claros en una fila horizontal limpia */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 relative\">\n          \n          {/* Sutil l\303\255nea conector en desktop */}\n          <div className=\"hidden lg:block absolute top-12 left-[12%] right-[12%] h-0.5 bg-[#EAE3D2] -z-0\" />\n\n          {PROCESS_STEPS.map((step, index) => (\n            <motion.div\n              key={step.number}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5, delay: index * 0.15 }}\n              className=\"bg-[#FDFBF7] p-8 rounded-2xl border border-[#EAE3D2]/80 space-y-4 relative z-10 hover:border-[#D17A5D]/40 transition-all duration-300 shadow-2xs\"\n            >\n              {/* N\303\272mero grande estilizado */}\n              <div className=\"font-serif text-4xl sm:text-5xl text-[#C86D51] font-light tracking-tight\">\n                {step.number}\n              </div>\n\n              {/* T\303\255tulo corto */}\n              <h3 className=\"font-serif text-xl text-[#2C3527] font-medium pt-1\">\n                {step.title}\n              </h3>\n\n              {/* Una l\303\255nea de texto (descripci\303\263n clara) */}\n              <p className=\"text-xs font-sans text-[#5C6654] font-light leading-relaxed\">\n                {step.description}\n              </p>\n\n              {/* Detalle adicional sutil */}\n              <div className=\"pt-2 border-t border-[#EAE3D2]/50 text-[11px] text-[#8C7A6B] font-sans\">\n                {step.details}\n              </div>\n            </motion.div>\n          ))}\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
