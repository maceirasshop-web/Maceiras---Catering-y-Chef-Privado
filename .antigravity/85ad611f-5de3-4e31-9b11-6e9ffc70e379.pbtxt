text-xl text-[#2C3527] font-medium pt-1\">\n                {step.title}\n              </h3>\n\n              {/* Una l\303\255nea de texto (descripci\303\263n clara) */}\n              <p className=\"text-xs font-sans text-[#5C6654] font-light leading-relaxed\">\n                {step.description}\n              </p>\n\n              {/* Detalle adicional sutil */}\n              <div className=\"pt-2 border-t border-[#EAE3D2]/50 text-[11px] text-[#8C7A6B] font-sans\">\n                {step.details}\n              </div>\n            </motion.div>\n          ))}\n        </div>\n\n      </div>\n    </section>"
