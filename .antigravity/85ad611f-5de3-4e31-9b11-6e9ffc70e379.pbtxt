er-t border-[#EAE3D2]/60 flex items-center justify-between text-xs font-sans\">\n                <div>\n                  <div className=\"font-medium text-[#2C3527]\">{testimonial.client}</div>\n                  <div className=\"text-[#8C7A6B]\">{testimonial.role}</div>\n                </div>\n                <div className=\"flex items-center gap-1 text-[#7A8572] bg-[#EAE3D2]/40 px-2.5 py-1 rounded-full text-[10px]\">\n                  <MapPin className=\"w-3 h-3 text-[#C86D51]\" />\n                  <span>{testimonial.location}</span>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
