 */}\n          <motion.div\n            initial={{ opacity: 0, y: 16 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, delay: 0.2, ease: [0.16, 1, 0.3, 1] }}\n            className=\"pt-2\"\n          >\n            <button\n              onClick={onOpenQuote}\n              className=\"group inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-[#3A4335] text-[#FAF8F5] text-sm uppercase tracking-widest font-medium transition-all duration-300 hover:bg-[#C86D51] hover:shadow-lg active:scale-98 cursor-pointer\"\n              id=\"hero-quote-btn\"\n            >\n              <span>Solicitar cotizaci\303\263n</span>\n              <ArrowRight className=\"w-4 h-4 transition-transform duration-300 group-hover:translate-x-1\" />\n            </button>\n          </motion.div>\n\n          {/* Indicadores sutiles de distinci\303\263n */}\n          <motion.div\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            transition={{ duration: 1, delay: 0.4 }}\n            className=\"pt-8 border-t border-[#EAE3D2]/70 flex items-center gap-8 text-xs text-[#7A8572] font-sans\"\n          >\n            <div className=\"flex flex-col\">\n              <span className=\"font-serif text-lg text-[#2C3527] font-medium\">+100%</span>\n              <span className=\"text-[11px] uppercase tracking-wider text-[#8C7A6B]\">Insumos Org\303\241nicos</span>\n            </div>\n            <div className=\"w-px h-8 bg-[#EAE3D2]\" />\n            <div className=\"flex flex-col\">\n              <span className=\"font-serif text-lg text-[#2C3527] font-medium\">Michelin</span>\n              <span className=\"text-[11px] uppercase tracking-wider text-[#8C7A6B]\">Trayectoria de Chef</span>\n            </div>\n            <div className=\"w-px h-8 bg-[#EAE3D2]\" />\n            <div className=\"flex flex-col\">\n              <span className=\"font-serif text-lg text-[#2C3527] font-medium\">Llave en Mano</span>\n              <span className=\"text-[11px] uppercase tracking-wider text-[#8C7A6B]\">Servicio Impecable</span>\n            </div>\n          </motion.div>\n\n        </div>\n\n        {/* LADO DERECHO: Escena 3D limpia y suave con Three.js */}\n        <div className=\"lg:col-span-6 relative flex items-center justify-center\">\n          <motion.div \n            initial={{ opacity: 0, scale: 0.95 }}\n            animate={{ opacity: 1, scale: 1 }}\n            transition={{ duration: 1.2, delay: 0.1, ease: [0.16, 1, 0.3, 1] }}\n            className=\"w-full relative\"\n          >\n            {/* Backdrop halo */}\n            <div className=\"absolute inset-0 bg-gradient-to-b from-[#EAE3D2]/30 via-transparent to-[#FAF8F5] rounded-3xl -z-10 transform scale-90 blur-2xl\" />\n            \n            <Hero3D />\n\n            {/* Micro hint overlay for interactivity */}\n            <div className=\"absolute bottom-2 right-4 text-[11px] tracking-wider uppercase text-[#8C7A6B]/80 font-sans pointer-events-none hidden sm:block\">\n              Interact\303\272a con el mouse \342\234\246 3D\n            </div>\n          </motion.div>\n        </div>\n\n      </div>\n    </section>"
        replacement_content: "    <section \n      id=\"hero\" \n      className=\"relative min-h-[92vh] flex items-center pt-28 pb-16 bg-[#F5F2ED] overflow-hidden\"\n    >\n      {/* Subtle organic light gradient background */}\n      <div className=\"absolute top-1/4 -left-20 w-96 h-96 bg-[#EADDCA]/40 rounded-full blur-3xl pointer-events-none\" />\n      <div className=\"absolute bottom-10 right-10 w-96 h-96 bg-[#D27D56]/10 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-6 lg:px-12 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center relative z-10\">\n        \n        {/* LADO IZQUIERDO: Texto refinado, limpio y aireado */}\n        <div className=\"lg:col-span-6 flex flex-col justify-center space-y-8 pr-0 lg:pr-6\">\n          \n          <motion.div\n            initial={{ opacity: 0, y: 16 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.8, ease: [0.16, 1, 0.3, 1] }}\n            className=\"space-y-6\"\n          >\n            {/* Tagline discreto */}\n            <div className=\"inline-block\">\n              <span className=\"pill-tag text-[#5A5A40] border-[#2A2A2A]/15 bg-[#EADDCA]/30\">\n                Catering Premium & Chefs Privados\n              </span>\n            </div>\n\n            {/* T\303\255tulo principal exacto con \303\251nfasis art\303\255stico */}\n            <h1 className=\"font-serif text-4xl sm:text-5xl lg:text-6xl tracking-tight text-[#2A2A2A] leading-[1.12] font-light\">\n              Experiencias gastron\303\263micas <span className=\"italic font-normal text-[#D27D56]\">que se sienten</span>\n            </h1>\n\n            {/* Subt\303\255tulo corto exacto */}\n            <p className=\"text-base sm:text-lg font-sans font-light text-[#2A2A2A]/70 max-w-md leading-relaxed\">\n              Catering premium y chefs privados dedicados a la creaci\303\263n de momentos memorables a trav\303\251s de la alta cocina org\303\241nica.\n 