          text: "      grain.rotation.set(Math.random(), Math.random(), Math.random());"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      wellingtonGroup.add(grain);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
