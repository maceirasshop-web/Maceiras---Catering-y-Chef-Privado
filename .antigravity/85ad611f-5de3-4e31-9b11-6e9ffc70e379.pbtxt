    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useRef } from \'react\';\nimport * as THREE from \'three\';\n\nexport const Hero3D: React.FC = () => {\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    if (!containerRef.current) return;\n\n    const container = containerRef.current;\n    const width = container.clientWidth;\n    const height = container.clientHeight;\n\n    // 1. Scene setup\n    const scene = new THREE.Scene();\n    scene.fog = new THREE.FogExp2(0xF5F2ED, 0.04);\n\n    // 2. Camera setup - Pulled back with tight FOV for generous margins and NO clipping\n    const camera = new THREE.PerspectiveCamera(30, width / height, 0.1, 100);\n    camera.position.set(0, 0.35, 9.2);\n\n    // 3. Renderer setup\n    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n    renderer.setSize(width, height);\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n    renderer.shadowMap.enabled = true;\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\n    renderer.toneMappingExposure = 1.25;\n\n    container.appendChild(renderer.domElement);\n\n    // 4. Studio Lighting Setup (Warm gourmet studio atmosphere)\n    const ambientLight = new THREE.AmbientLight(0xFFFAF2, 1.6);\n    scene.add(ambientLight);\n\n    // Key Light - Main warm directional light\n    const keyLight = new THREE.DirectionalLight(0xFFF4E5, 2.8);\n    keyLight.position.set(4, 7, 5);\n    keyLight.castShadow = true;\n    keyLight.shadow.mapSize.width = 2048;\n    keyLight.shadow.mapSize.height = 2048;\n    keyLight.shadow.camera.near = 0.5;\n    keyLight.shadow.camera.far = 16;\n    keyLight.shadow.bias = -0.0003;\n    scene.add(keyLight);\n\n    // Terracotta warm rim light from back-left\n    const rimLight = new THREE.DirectionalLight(0xD27D56, 1.4);\n    rimLight.position.set(-5, 2.5, -4);\n    scene.add(rimLight);\n\n    // Soft sage fill light\n    const fillLight = new THREE.PointLight(0x5A5A40, 0.95, 12);\n    fillLight.position.set(-3, 3, 3);\n    scene.add(fillLight);\n\n    // Highlight light over center dish\n    const foodSpot = new THREE.PointLight(0xFFE8D0, 1.8, 8);\n    foodSpot.position.set(0, 3.5, 2);\n    scene.add(foodSpot);\n\n    // 5. High-Resolution Procedural Textures\n    const createPastryTexture = () => {\n      const canvas = document.createElement(\'canvas\');\n      canvas.width = 512;\n      canvas.height = 512;\n      const ctx = canvas.getContext(\'2d\');\n      if (ctx) {\n        ctx.fillStyle = \'#D99B52\';\n        ctx.fillRect(0, 0, 512, 512);\n\n        // Golden baked pastry highlights & roasted dark specks\n        for (let i = 0; i < 400; i++) {\n          ctx.fillStyle = Math.random() > 0.5 ? \'#ECC07E\' : \'#9E5F20\';\n          ctx.beginPath();\n          ctx.arc(Math.random() * 512, Math.random() * 512, Math.random() * 6 + 1.5, 0, Math.PI * 2);\n          ctx.fill();\n        }\n\n        // Diamond lattice scoring pattern of Filet Wellington\n        ctx.strokeStyle = \'#703D14\';\n        ctx.lineWidth = 4.5;\n        for (let i = -512; i < 1024; i += 32) {\n          ctx.beginPath();\n          ctx.moveTo(i, 0);\n          ctx.lineTo(i + 512, 512);\n          ctx.stroke();\n\n          ctx.beginPath();\n          ctx.moveTo(i, 512);\n          ctx.lineTo(i + 512, 0);\n          ctx.stroke();\n        }\n      }\n      const tex = new THREE.CanvasTexture(canvas);\n      tex.wrapS = THREE.RepeatWrapping;\n      tex.wrapT = THREE.RepeatWrapping;\n      tex.repeat.set(2, 2);\n      return tex;\n    };\n\n    const createCaramelTexture = () => {\n      const canvas = document.createElement(\'canvas\');\n      canvas.width = 512;\n      canvas.height = 512;\n      const ctx = canvas.getContext(\'2d\');\n      if (ctx) {\n        const grad = ctx.createRadialGradient(256, 256, 15, 256, 256, 256);\n        grad.addColorStop(0, \'#FCB144\');\n        grad.addColorStop(0.45, \'#C46B18\');\n        grad.addColorStop(0.8, \'#782E06\');\n        grad.addColorStop(1, \'#3D1302\');\n        ctx.fillStyle = grad;\n        ctx.fillRect(0, 0, 512, 512);\n\n        ctx.strokeStyle = \'#210900\';\n        ctx.lineWidth = 3;\n        for (let i = 0; i < 40; i++) {\n          ctx.beginPath();\n          ctx.moveTo(Math.random() * 512, Math.random() * 512);\n          ctx.lineTo(Math.random() * 512, Math.random() * 512);\n          ctx.stroke();\n        }\n      }\n      return new THREE.CanvasTexture(canvas);\n    };\n\n    const pastryTex = createPastryTexture();\n    const caramelTex = createCaramelTexture();\n\n    // Shared Materials\n    const ceramicMat = new THREE.MeshStandardMaterial({\n      color: 0xFCFAFA,\n      roughness: 0.1,\n      metalness: 0.05,\n    });\n\n    const goldMat = new THREE.MeshStandardMaterial({\n      color: 0xD4AF37,\n      roughness: 0.18,\n      metalness: 0.92,\n    });\n\n    const silverMat = new THREE.MeshStandardMaterial({\n      color: 0xE8E8E8,\n      roughness: 0.12,\n      metalness: 0.95,\n    });\n\n    const beefCenterMat = new THREE.MeshStandardMaterial({\n      color: 0xA32E3A, // Medium rare Filet Mignon core\n      roughness: 0.3,\n      metalness: 0.05,\n    });\n\n    const duxellesMat = new THREE.MeshStandardMaterial({\n      color: 0x38261B, // Mushroom duxelles & truffle paste\n      roughness: 0.75,\n    });\n\n    const pastryMat = new THREE.MeshStandardMaterial({\n      map: pastryTex,\n      roughness: 0.45,\n      metalness: 0.0,\n    });\n\n    const risottoMat = new THREE.MeshStandardMaterial({\n      color: 0xF7EFE2, // Arborio risotto base\n      roughness: 0.35,\n      metalness: 0.0,\n    });\n\n    const wineSauceMat = new THREE.MeshStandardMaterial({\n      color: 0x470D18, // Glossy red wine glaze reduction\n      roughness: 0.04,\n      metalness: 0.15,\n    });\n\n    const herbMat = new THREE.MeshStandardMaterial({\n      color: 0x3B5E2B,\n      roughness: 0.35,\n    });\n\n    const glassMat = new THREE.MeshPhysicalMaterial({\n      color: 0xFFFFFF,\n      transparent: true,\n      opacity: 0.28,\n      roughness: 0.03,\n      transmission: 0.94,\n      thickness: 0.9,\n      ior: 1.5,\n    });\n\n    const berryMat = new THREE.MeshStandardMaterial({\n      color: 0xC41E3A,\n      roughness: 0.2,\n      metalness: 0.05,\n    });\n\n    const caramelMat = new THREE.MeshStandardMaterial({\n      map: caramelTex,\n      roughness: 0.06,\n      metalness: 0.15,\n    });\n\n    // 6. Dishes Container\n    const dishesGroup = new THREE.Group();\n    scene.add(dishesGroup);\n\n    // ==========================================\n    // DISH 1: FILETE WELLINGTON CON RISOTTO (Centro)\n    // ==========================================\n    const wellingtonGroup = new THREE.Group();\n\n    // Porcelain Plate\n    const plateGeo = new THREE.CylinderGeometry(1.4, 0.85, 0.13, 64);\n    const plate = new THREE.Mesh(plateGeo, ceramicMat);\n    plate.castShadow = true;\n    plate.receiveShadow = true;\n    wellingtonGroup.add(plate);\n\n    // Gold rim detail\n    const plateRimGeo = new THREE.TorusGeometry(1.37, 0.015, 16, 64);\n    const plateRim = new THREE.Mesh(plateRimGeo, goldMat);\n    plateRim.rotation.x = Math.PI / 2;\n    plateRim.position.y = 0.066;\n    wellingtonGroup.add(plateRim);\n\n    // Red wine glaze pool\n    const sauceGeo = new THREE.CylinderGeometry(1.0, 1.0, 0.016, 48);\n    const sauce = new THREE.Mesh(sauceGeo, wineSauceMat);\n    sauce.position.y = 0.071;\n    wellingtonGroup.add(sauce);\n\n    // Risotto Mound\n    const risottoGeo = new THREE.CylinderGeometry(0.78, 0.82, 0.11, 48);\n    const risotto = new THREE.Mesh(risottoGeo, risottoMat);\n    risotto.position.y = 0.125;\n    risotto.castShadow = true;\n    risotto.receiveShadow = true;\n    wellingtonGroup.add(risotto);\n\n    // Rice grains\n    for (let i = 0; i < 24; i++) {\n      const grainGeo = new THREE.CapsuleGeometry(0.024, 0.045, 4, 8);\n      const grain = new THREE.Mesh(grainGeo, risottoMat);\n      const a = Math.random() * Math.PI * 2;\n      const r = Math.random() * 0.65;\n      grain.position.set(Math.cos(a) * r, 0.19, Math.sin(a) * r);\n      grain.rotation.set(Math.random(), Math.random(), Math.random());\n      wellingtonGroup.add(grain);\n    }\n\n    // Wellington Sliced Steak\n    const wellingtonSlice = new THREE.Group();\n\n    const pastryGeo = new THREE.CylinderGeometry(0.46, 0.46, 0.4, 32, 1, false, 0, Math.PI * 1.35);\n    const pastry = new THREE.Mesh(pastryGeo, pastryMat);\n    pastry.castShadow = true;\n    wellingtonSlice.add(pastry);\n\n    const duxellesGeo = new THREE.CylinderGeometry(0.41, 0.41, 0.4, 32, 1, false, 0, Math.PI * 1.35);\n    const duxelles = new THREE.Mesh(duxellesGeo, duxellesMat);\n    duxelles.position.y = 0.001;\n    wellingtonSlice.add(duxelles);\n\n    const beefGeo = new THREE.CylinderGeometry(0.35, 0.35, 0.402, 32);\n    const beef = new THREE.Mesh(beefGeo, beefCenterMat);\n    beef.castShadow = true;\n    wellingtonSlice.add(beef);\n\n    wellingtonSlice.rotation.x = Math.PI / 2;\n    wellingtonSlice.rotation.z = -0.35;\n    wellingtonSlice.position.set(-0.05, 0.31, 0.05);\n    wellingtonGroup.add(wellingtonSlice);\n\n    // Herbs Garnish\n    const stemGeo = new THREE.CylinderGeometry(0.012, 0.012, 0.55, 8);\n    const stem = new THREE.Mesh(stemGeo, herbMat);\n    stem.rotation.z = 1.1;\n    stem.rotation.x = 0.3;\n    stem.position.set(0.18, 0.4, 0.18);\n    wellingtonGroup.add(stem);\n\n    for (let i = 0; i < 12; i++) {\n      const leafGeo = new THREE.ConeGeometry(0.02, 0.09, 4);\n      const leaf = new THREE.Mesh(leafGeo, herbMat);\n      leaf.position.set(\n        0.18 + (Math.random() - 0.5) * 0.28,\n        0.4 + Math.random() * 0.05,\n        0.18 + (Math.random() - 0.5) * 0.28\n      );\n      leaf.rotation.set(Math.random(), Math.random(), Math.random());\n      wellingtonGroup.add(leaf);\n    }\n\n    wellingtonGroup.position.set(0, -0.4, 0.2);\n    wellingtonGroup.rotation.x = 0.44;\n    wellingtonGroup.rotation.z = -0.05;\n    dishesGroup.add(wellingtonGroup);\n\n    // ==========================================\n    // DISH 2: CLOCHE Y BANDEJA DE PRESENTACI\303\223N (Derecha)\n    // ==========================================\n    const clocheGroup = new THREE.Group();\n\n    const trayGeo = new THREE.CylinderGeometry(0.85, 0.52, 0.08, 48);\n    const tray = new THREE.Mesh(trayGeo, silverMat);\n    tray.castShadow = true;\n    tray.receiveShadow = true;\n    clocheGroup.add(tray);\n\n    const trayRimGeo = new THREE.TorusGeometry(0.83, 0.018, 16, 48);\n    const trayRim = new THREE.Mesh(trayRimGeo, goldMat);\n    trayRim.rotation.x = Math.PI / 2;\n    trayRim.position.y = 0.041;\n    clocheGroup.add(trayRim);\n\n    const domeGeo = new THREE.SphereGeometry(0.64, 32, 24, 0, Math.PI * 2, 0, Math.PI * 0.5);\n    const dome = new THREE.Mesh(domeGeo, glassMat);\n    dome.position.y = 0.04;\n    clocheGroup.add(dome);\n\n    const knobGeo = new THREE.SphereGeometry(0.085, 16, 16);\n    const knob = new THREE.Mesh(knobGeo, goldMat);\n    knob.position.y = 0.68;\n    clocheGroup.add(knob);\n\n    const biteGeo = new THREE.DodecahedronGeometry(0.17, 1);\n    const biteMat = new THREE.MeshStandardMaterial({ color: 0xD27D56, roughness: 0.3 });\n    const bite = new THREE.Mesh(biteGeo, biteMat);\n    bite.position.y = 0.17;\n    bite.castShadow = true;\n    clocheGroup.add(bite);\n\n    // Positioned at x = 1.3 to guarantee NO right-side clipping\n    clocheGroup.position.set(1.3, 0.7, -0.35);\n    clocheGroup.rotation.x = 0.48;\n    clocheGroup.rotation.y = -0.2;\n    dishesGroup.add(clocheGroup);\n\n    // ==========================================\n    // DISH 3: CR\303\210ME BR\303\233L\303\211E Y FRAMBUESAS (Izquierda)\n    // ==========================================\n    const bruleeGroup = new THREE.Group();\n\n    const ramekinGeo = new THREE.CylinderGeometry(0.58, 0.48, 0.36, 32);\n    const ramekin = new THREE.Mesh(ramekinGeo, ceramicMat);\n    ramekin.castShadow = true;\n    ramekin.receiveShadow = true;\n    bruleeGroup.add(ramekin);\n\n    const caramelGeo = new THREE.CylinderGeometry(0.54, 0.54, 0.02, 32);\n    const caramel = new THREE.Mesh(caramelGeo, caramelMat);\n    caramel.position.y = 0.16;\n    caramel.receiveShadow = true;\n    bruleeGroup.add(caramel);\n\n    for (let i = 0; i < 3; i++) {\n      const berryGroup = new THREE.Group();\n      for (let j = 0; j < 12; j++) {\n        const dGeo = new THREE.SphereGeometry(0.019, 8, 8);\n        const drupelet = new THREE.Mesh(dGeo, berryMat);\n        const angle = (j / 12) * Math.PI * 2;\n        drupelet.position.set(Math.cos(angle) * 0.026, (j % 3) * 0.013, Math.sin(angle) * 0.026);\n        berryGroup.add(drupelet);\n      }\n      const angle = (i / 3) * Math.PI * 2;\n      berryGroup.position.set(Math.cos(angle) * 0.17, 0.2, Math.sin(angle) * 0.17);\n      bruleeGroup.add(berryGroup);\n    }\n\n    const spoonHandleGeo = new THREE.CylinderGeometry(0.01, 0.013, 0.6, 8);\n    const spoonHandle = new THREE.Mesh(spoonHandleGeo, goldMat);\n    spoonHandle.rotation.z = 1.3;\n    spoonHandle.rotation.x = 0.2;\n    spoonHandle.position.set(0.48, 0.05, 0.1);\n    bruleeGroup.add(spoonHandle);\n\n    const spoonBowlGeo = new THREE.SphereGeometry(0.07, 16, 12, 0, Math.PI * 2, 0, Math.PI * 0.5);\n    const spoonBowl = new THREE.Mesh(spoonBowlGeo, goldMat);\n    spoonBowl.rotation.x = -Math.PI / 2;\n    spoonBowl.position.set(0.18, 0.05, 0.26);\n    bruleeGroup.add(spoonBowl);\n\n    // Positioned at x = -1.3 for symmetric balance\n    bruleeGroup.position.set(-1.3, 0.55, -0.35);\n    bruleeGroup.rotation.x = 0.44;\n    bruleeGroup.rotation.y = 0.3;\n    dishesGroup.add(bruleeGroup);\n\n    // Floor Shadow Receiver - Extra wide plane\n    const shadowPlaneGeo = new THREE.PlaneGeometry(24, 24);\n    const shadowPlaneMat = new THREE.ShadowMaterial({ opacity: 0.09 });\n    const shadowPlane = new THREE.Mesh(shadowPlaneGeo, shadowPlaneMat);\n    shadowPlane.rotation.x = -Math.PI / 2;\n    shadowPlane.position.y = -1.8;\n    shadowPlane.receiveShadow = true;\n    scene.add(shadowPlane);\n\n    // 7. Interactive Parallax & Animation Loop\n    let mouseX = 0;\n    let mouseY = 0;\n    let targetX = 0;\n    let targetY = 0;\n\n    const handleMouseMove = (e: MouseEvent) => {\n      const rect = container.getBoundingClientRect();\n      const x = (e.clientX - rect.left) / rect.width - 0.5;\n      const y = (e.clientY - rect.top) / rect.height - 0.5;\n      targetX = x * 0.5;\n      targetY = y * 0.5;\n    };\n\n    window.addEventListener(\'mousemove\', handleMouseMove);\n\n    let animationFrameId: number;\n    let clock = new THREE.Clock();\n\n    const animate = () => {\n      animationFrameId = requestAnimationFrame(animate);\n\n      const elapsedTime = clock.getElapsedTime();\n\n      // Smooth mouse interpolation\n      mouseX += (targetX - mouseX) * 0.05;\n      mouseY += (targetY - mouseY) * 0.05;\n\n      // Subtle hover movement\n      dishesGroup.rotation.y = mouseX * 0.3 + Math.sin(elapsedTime * 0.2) * 0.03;\n      dishesGroup.rotation.x = -mouseY * 0.2 + Math.cos(elapsedTime * 0.15) * 0.02;\n\n      // Floating animation\n      wellingtonGroup.position.y = -0.4 + Math.sin(elapsedTime * 1.1) * 0.05;\n      wellingtonGroup.rotation.y = Math.sin(elapsedTime * 0.4) * 0.06;\n\n      clocheGroup.position.y = 0.7 + Math.sin(elapsedTime * 0.85 + 1) * 0.05;\n      clocheGroup.rotation.z = Math.cos(elapsedTime * 0.5) * 0.04;\n\n      bruleeGroup.position.y = 0.55 + Math.sin(elapsedTime * 1.0 + 2) * 0.05;\n      bruleeGroup.rotation.x = 0.44 + Math.sin(elapsedTime * 0.6) * 0.03;\n\n      renderer.render(scene, camera);\n    };\n\n    animate();\n\n    // 8. Resize Handler\n    const handleResize = () => {\n      if (!containerRef.current) return;\n      const w = containerRef.current.clientWidth;\n      const h = containerRef.current.clientHeight;\n      camera.aspect = w / h;\n      camera.updateProjectionMatrix();\n      renderer.setSize(w, h);\n    };\n\n    window.addEventListener(\'resize\', handleResize);\n\n    // Cleanup\n    return () => {\n      window.removeEventListener(\'mousemove\', handleMouseMove);\n      window.removeEventListener(\'resize\', handleResize);\n      cancelAnimationFrame(animationFrameId);\n\n      [plateGeo, plateRimGeo, sauceGeo, risottoGeo, pastryGeo, duxellesGeo, beefGeo, stemGeo, trayGeo, trayRimGeo, domeGeo, knobGeo, biteGeo, ramekinGeo, caramelGeo, spoonHandleGeo, spoonBowlGeo, shadowPlaneGeo].forEach(g => g.dispose());\n      [ceramicMat, goldMat, silverMat, beefCenterMat, duxellesMat, pastryMat, risottoMat, wineSauceMat, herbMat, glassMat, berryMat, caramelMat, shadowPlaneMat].forEach(m => m.dispose());\n      pastryTex.dispose();\n      caramelTex.dispose();\n      renderer.dispose();\n\n      if (container && renderer.domElement && container.contains(renderer.domElement)) {\n        container.removeChild(renderer.domElement);\n      }\n    };\n  }, []);\n\n  return (\n    <div \n      ref={containerRef} \n      className=\"w-full h-[460px] md:h-[580px] relative flex items-center justify-center cursor-grab active:cursor-grabbing\"\n      aria-label=\"Escena 3D interactiva de gastronom\303\255a Maceiras con Filete Wellington, Cr\303\250me Br\303\273l\303\251e y Cloche\"\n    >\n      {/* Soft warm background halo */}\n      <div className=\"absolute inset-0 pointer-events-none flex items-center justify-center\">\n        <div className=\"w-96 h-96 rounded-full bg-gradient-to-tr from-[#EADDCA]/30 via-transparent to-[#D27D56]/15 blur-3xl opacity-70\" />\n      </div>\n    </div>\n  );\n};\n"
    }
