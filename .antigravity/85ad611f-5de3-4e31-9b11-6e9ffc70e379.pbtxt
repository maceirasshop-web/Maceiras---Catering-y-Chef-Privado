    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { X, Sparkles, Utensils, GlassWater, Tag } from \'lucide-react\';\nimport { DISHES_DATA } from \'../data/cateringData\';\nimport { DishItem } from \'../types\';\n\nexport const SpecialtiesSection: React.FC = () => {\n  const [selectedDish, setSelectedDish] = useState<DishItem | null>(null);\n  const [activeCategory, setActiveCategory] = useState<string>(\'todos\');\n\n  const filteredDishes = activeCategory === \'todos\' \n    ? DISHES_DATA \n    : DISHES_DATA.filter(d => d.category === activeCategory);\n\n  return (\n    <section id=\"especialidades\" className=\"py-24 bg-[#FDFBF7] relative border-t border-[#EAE3D2]/50\">\n      <div className=\"max-w-7xl mx-auto px-6 lg:px-12\">\n        \n        {/* Header de la secci\303\263n */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6\">\n          <div className=\"max-w-xl space-y-3\">\n            <span className=\"text-xs uppercase tracking-widest text-[#C86D51] font-medium font-sans\">\n              Alta Culinaria\n            </span>\n            <h2 className=\"font-serif text-3xl sm:text-4xl text-[#2C3527] font-normal leading-tight\">\n              Especialidades de temporada\n            </h2>\n            <p className=\"text-[#5C6654] font-sans font-light text-base\">\n              Creaciones concebidas con ingrediente noble, precisi\303\263n t\303\251cnica y sensibilidad mediterr\303\241nea.\n            </p>\n          </div>\n\n          {/* Selector de categor\303\255as sutil */}\n          <div className=\"flex flex-wrap gap-2 pt-2\">\n            {[\n              { id: \'todos\', label: \'Todos\' },\n              { id: \'entrantes\', label: \'Entrantes\' },\n              { id: \'principales\', label: \'Principales\' },\n              { id: \'postres\', label: \'Postres\' }\n            ].map(cat => (\n              <button\n                key={cat.id}\n                onClick={() => setActiveCategory(cat.id)}\n                className={`px-4 py-2 rounded-full text-xs uppercase tracking-wider font-medium transition-all duration-200 cursor-pointer ${\n                  activeCategory === cat.id\n                    ? \'bg-[#3A4335] text-[#FAF8F5]\'\n                    : \'bg-[#EAE3D2]/40 text-[#5C6654] hover:bg-[#EAE3D2]/80\'\n                }`}\n              >\n                {cat.label}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Grid limpio de 4 platos destacados con espaciado generoso */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8\">\n          {filteredDishes.map((dish, index) => (\n            <motion.div\n              key={dish.id}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5, delay: index * 0.12 }}\n              onClick={() => setSelectedDish(dish)}\n              className=\"group bg-[#FAF8F5] rounded-2xl border border-[#EAE3D2]/70 overflow-hidden shadow-2xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between cursor-pointer\"\n            >\n              <div>\n                {/* Imagen del plato */}\n                <div className=\"relative h-56 w-full overflow-hidden bg-[#EAE3D2]\">\n                  <img\n                    src={dish.image}\n                    alt={dish.name}\n                    referrerPolicy=\"no-referrer\"\n                    className=\"w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105\"\n                  />\n                  <div className=\"absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors\" />\n                  \n                  {/* Etiqueta de categor\303\255a en esquina */}\n                  <div className=\"absolute top-3 left-3 px-3 py-1 rounded-full bg-[#FAF8F5]/90 backdrop-blur-xs text-[10px] uppercase tracking-wider text-[#3A4335] font-medium font-sans\">\n                    {dish.category}\n                  </div>\n                </div>\n\n                {/* Info b\303\241sica del plato */}\n                <div className=\"p-6 space-y-3\">\n                  <h3 className=\"font-serif text-xl text-[#2C3527] group-hover:text-[#C86D51] transition-colors leading-snug\">\n                    {dish.name}\n                  </h3>\n\n                  {/* Descripci\303\263n corta exactas */}\n                  <p className=\"text-xs font-sans text-[#5C6654] font-light leading-relaxed line-clamp-2\">\n                    {dish.description}\n                  </p>\n\n                  {/* Tags r\303\241pidos */}\n                  <div className=\"flex flex-wrap gap-1.5 pt-1\">\n                    {dish.tags.slice(0, 2).map((tag, tIdx) => (\n                      <span \n                        key={tIdx} \n                        className=\"inline-flex items-center gap-1 text-[10px] text-[#7A8572] bg-[#EAE3D2]/50 px-2 py-0.5 rounded-sm\"\n                      >\n                        <span>{tag}</span>\n                      </span>\n                    ))}\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"px-6 pb-6 pt-1 text-[11px] uppercase tracking-wider text-[#C86D51] font-medium flex items-center justify-between\">\n                <span>Ver propuesta & maridaje</span>\n                <span>\342\206\222</span>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n\n      </div>\n\n      {/* Modal de Detalle de Platillo */}\n      <AnimatePresence>\n        {selectedDish && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-[#2C3527]/60 backdrop-blur-sm\">\n            <motion.div\n              initial={{ opacity: 0, scale: 0.95, y: 10 }}\n              animate={{ opacity: 1, scale: 1, y: 0 }}\n              exit={{ opacity: 0, scale: 0.95, y: 10 }}\n              transition={{ duration: 0.3 }}\n              className=\"bg-[#FAF8F5] rounded-3xl max-w-xl w-full overflow-hidden shadow-2xl border border-[#EAE3D2] relative flex flex-col\"\n            >\n              <div className=\"relative h-64 w-full bg-[#EAE3D2]\">\n                <img\n                  src={selectedDish.image}\n                  alt={selectedDish.name}\n                  referrerPolicy=\"no-referrer\"\n                  className=\"w-full h-full object-cover\"\n                />\n                <button\n                  onClick={() => setSelectedDish(null)}\n                  className=\"absolute top-4 right-4 w-9 h-9 rounded-full bg-[#FAF8F5]/90 text-[#2C3527] flex items-center justify-center hover:bg-[#C86D51] hover:text-white transition-colors cursor-pointer\"\n                  aria-label=\"Cerrar modal\"\n                >\n                  <X className=\"w-5 h-5\" />\n                </button>\n              </div>\n\n              <div className=\"p-6 sm:p-8 space-y-5\">\n                <div>\n                  <span className=\"text-[10px] uppercase tracking-widest text-[#C86D51] font-medium font-sans\">\n                    {selectedDish.category}\n                  </span>\n                  <h3 className=\"font-serif text-2xl sm:text-3xl text-[#2C3527] mt-1\">\n                    {selectedDish.name}\n                  </h3>\n                  <p className=\"text-sm text-[#5C6654] font-light mt-2 leading-relaxed\">\n                    {selectedDish.detailedDescription}\n                  </p>\n                </div>\n\n                {/* Ingredientes clave */}\n                <div className=\"space-y-2 pt-2 border-t border-[#EAE3D2]\">\n                  <div className=\"flex items-center gap-2 text-xs uppercase tracking-wider text-[#8C7A6B] font-medium\">\n                    <Utensils className=\"w-3.5 h-3.5 text-[#C86D51]\" />\n                    <span>Ingredientes principales</span>\n                  </div>\n                  <div className=\"flex flex-wrap gap-2\">\n                    {selectedDish.ingredients.map((ing, iIdx) => (\n                      <span key={iIdx} className=\"text-xs bg-[#EAE3D2]/60 text-[#3A4335] px-2.5 py-1 rounded-full\">\n                        {ing}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Maridaje recomendado */}\n                <div className=\"p-4 rounded-xl bg-[#F5F2EB] border border-[#EAE3D2] space-y-1\">\n                  <div className=\"flex items-center gap-2 text-xs uppercase tracking-wider text-[#3A4335] font-medium\">\n                    <GlassWater className=\"w-3.5 h-3.5 text-[#C86D51]\" />\n                    <span>Maridaje del Sommelier</span>\n                  </div>\n                  <p className=\"text-xs text-[#5C6654] italic font-serif\">\n                    \"{selectedDish.pairing}\"\n                  </p>\n                </div>\n\n                {selectedDish.chefNote && (\n                  <p className=\"text-xs text-[#8C7A6B] font-sans italic\">\n                    Nota del chef: {selectedDish.chefNote}\n                  </p>\n                )}\n              </div>\n\n              <div className=\"p-6 bg-[#FDFBF7] border-t border-[#EAE3D2] flex justify-end\">\n                <button\n                  onClick={() => setSelectedDish(null)}\n                  className=\"px-6 py-2.5 rounded-full bg-[#3A4335] text-[#FAF8F5] text-xs uppercase tracking-widest font-medium hover:bg-[#C86D51] transition-colors\"\n                >\n                  Entendido\n                </button>\n              </div>\n            </motion.div>\n          </div>\n        )}\n      </AnimatePresence>\n    </section>\n  );\n};\n"
    }
