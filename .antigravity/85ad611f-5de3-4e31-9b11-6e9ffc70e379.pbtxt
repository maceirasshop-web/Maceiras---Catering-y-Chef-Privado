          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // 6. Mouse Parallax & Animation Loop"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let mouseX = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let mouseY = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let targetX = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let targetY = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const handleMouseMove = (e: MouseEvent) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const rect = container.getBoundingClientRect();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const x = (e.clientX - rect.left) / rect.width - 0.5;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const y = (e.clientY - rect.top) / rect.height - 0.5;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      targetX = x * 0.4;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      targetY = y * 0.4;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    window.addEventListener(\'mousemove\', handleMouseMove);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let animationFrameId: number;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let clock = new THREE.Clock();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const animate = () => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      animationFrameId = requestAnimationFrame(animate);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const elapsedTime = clock.getElapsedTime();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // Slow rotation of particles and rings"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      particles.rotation.y = elapsedTime * 0.04;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      particles.rotation.x = Math.sin(elapsedTime * 0.02) * 0.05;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      ring.rotation.z = elapsedTime * 0.08;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      secondRing.rotation.x = elapsedTime * -0.06;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      // Smooth mouse interpolation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      mouseX += (targetX - mouseX) * 0.05;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
