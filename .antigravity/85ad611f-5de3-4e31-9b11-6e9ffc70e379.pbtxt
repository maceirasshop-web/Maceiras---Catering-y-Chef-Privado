        lines {
          text: "    // Floor Shadow Receiver - Extra large area with smooth falloff"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const shadowPlaneGeo = new THREE.PlaneGeometry(30, 30);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const shadowPlaneMat = new THREE.ShadowMaterial({ opacity: 0.08 });"
