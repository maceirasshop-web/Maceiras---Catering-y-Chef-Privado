        lines {
          text: "      const rect = container.getBoundingClientRect();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const x = (e.clientX - rect.left) / rect.width - 0.5;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const y = (e.clientY - rect.top) / rect.height - 0.5;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      targetX = x * 0.8;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
