        target_content: "    <section id=\"opiniones\" className=\"py-20 bg-[#FDFBF7] relative border-t border-[#EAE3D2]/50\">\n      <div className=\"max-w-7xl mx-auto px-6 lg:px-12\">\n        \n        <div className=\"text-center max-w-xl mx-auto mb-16 space-y-3\">\n          <span className=\"text-xs uppercase tracking-widest text-[#C86D51] font-medium font-sans\">\n            Experiencias Memorables\n          </span>\n          <h2 className=\"font-serif text-3xl sm:text-4xl text-[#2C3527] font-normal\">\n            Lo que dicen nuestros comensales\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n          {TESTIMONIALS_DATA.map((testimonial, index) => (\n            <motion.div\n              key={testimonial.id}\n              initial={{ opacity: 0, y: 16 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5, delay: index * 0.12 }}\n              className=\"bg-[#FAF8F5] p-8 rounded-2xl border border-[#EAE3D2]/70 flex flex-col justify-between space-y-6 relative\"\n            >\n              <div className=\"space-y-4\">\n                <div className=\"flex items-center gap-1 text-[#C86D51]\">\n                  {[...Array(testimonial.rating)].map((_, i) => (\n                    <Star key={i} className=\"w-4 h-4 fill-current\" />\n                  ))}\n                </div>\n\n                <Quote className=\"w-8 h-8 text-[#EAE3D2]\" />\n\n                <p className=\"font-serif text-base text-[#3A4335] leading-relaxed italic\">\n                  \"{testimonial.quote}\"\n                </p>\n              </div>\n\n              <div className=\"pt-4 border-t border-[#EAE3D2]/60 flex items-center justify-between text-xs font-sans\">\n                <div>\n                  <div className=\"font-medium text-[#2C3527]\">{testimonial.client}</div>\n                  <div className=\"text-[#8C7A6B]\">{testimonial.role}</div>\n                </div>\n                <div className=\"flex items-center gap-1 text-[#7A8572] bg-[#EAE3D2]/40 px-2.5 py-1 rounded-full text-[10px]\">\n                  <MapPin className=\"w-3 h-3 text-[#C86D51]\" />\n                  <span>{testimonial.location}</span>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n\n      </div>\n    </section>"
        replacement_content: "    <section id=\"opiniones\" className=\"py-20 bg-[#F5F2ED] relative border-t border-[#2A2A2A]/10\">\n      <div className=\"max-w-7xl mx-auto px-6 lg:px-12\">\n        \n        <div className=\"text-center max-w-xl mx-auto mb-16 space-y-3\">\n          <span className=\"text-xs uppercase tracking-widest text-[#D27D56] font-medium font-sans\">\n            Experiencias Memorables\n          </span>\n          <h2 className=\"font-serif text-3xl sm:text-4xl text-[#2A2A2A] font-light\">\n            Lo que dicen <span className=\"italic font-normal\">nuestros comensales</span>\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n          {TESTIMONIALS_DATA.map((testimonial, index) => (\n            <motion.div\n              key={testimonial.id}\n              initial={{ opacity: 0, y: 16 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5, delay: index * 0.12 }}\n              className=\"bg-white p-8 rounded-xs border border-[#2A2A2A]/10 card-shadow flex flex-col justify-between space-y-6 relative\"\n            >\n              <div className=\"space-y-4\">\n                <div className=\"flex items-center gap-1 text-[#D27D56]\">\n                  {[...Array(testimonial.rating)].map((_, i) => (\n                    <Star key={i} className=\"w-3.5 h-3.5 fill-current\" />\n                  ))}\n                </div>\n\n                <Quote className=\"w-8 h-8 text-[#EADDCA]\" />\n\n                <p className=\"font-serif text-base text-[#2A2A2A] leading-relaxed italic font-light\">\n                  \"{testimonial.quote}\"\n                </p>\n              </div>\n\n              <div className=\"pt-4 border-t border-[#2A2A2A]/10 flex items-center justify-between text-xs font-sans\">\n                <div>\n                  <div className=\"font-medium text-[#2A2A2A]\">{testimonial.client